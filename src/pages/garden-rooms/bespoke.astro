---
import ServiceLayout from '../../components/ServiceLayout.astro';

const features = [
  { icon: 'ruler', title: 'Any Shape, Any Size', desc: 'L-shaped, T-shaped, curved rooflines, awkward plots — if it can be designed, we can build it. Nothing is off the table.' },
  { icon: 'pencil', title: 'Every Detail Your Choice', desc: 'Size, structure, roof style, cladding, doors, windows, interior finish, electrics, climate control — all specified to your requirements.' },
  { icon: 'leaf', title: 'Premium Materials Only', desc: 'FSC and PEFC certified timber, 30+ year cladding options, A-rated glazing, EPDM or metal roofing. No compromises.' },
  { icon: 'layers', title: 'SIPs Construction Throughout', desc: 'Every bespoke build uses structural insulated panels — the same system that gives our standard range its performance.' },
  { icon: 'key', title: 'Fully Turnkey', desc: 'Design, foundations, structure, cladding, glazing, electrics, flooring, plastering, and site clean-up all handled by us.' },
  { icon: 'users', title: 'Free Design Consultation', desc: 'We start with a free site visit and design consultation — no obligation, no hard sell. Just honest advice about what\'s possible.' },
];

const useCases = [
  { title: 'Music Studio', desc: 'Acoustic wall panelling, specialist soundproofing, custom dimensions to suit your equipment.', img: '/images/internal%20shot%20of%20music%20room.webp' },
  { title: 'L-Shaped Garden Office', desc: 'Maximise an awkward corner plot with a custom L-shaped footprint that uses space a standard build cannot.', img: '/images/GR%20bespoke%20glass%20corner%20millboard.webp' },
  { title: 'Garden Gym', desc: 'Reinforced flooring, rubber matting, mirrored walls, heavy-duty electrics — built around your equipment list.', img: '/images/garden%20gym%20internal%201.webp' },
  { title: 'Outdoor Living Space', desc: 'Open-plan structures that blend indoor and outdoor living — perfect for entertaining year-round.', img: '/images/Bespoke%20garden%20room%20end%20of%20garden.webp' },
];

const related = [
  { label: 'Garden Offices', href: '/garden-rooms/garden-offices', img: '/images/GP%20office%20internal.webp' },
  { label: 'Golf Simulator Studios', href: '/garden-rooms/golf-simulator-studios', img: '/images/HERO%20Golf%20sim.webp' },
  { label: 'Garden Rooms with Storage', href: '/garden-rooms/garden-rooms-with-storage', img: '/images/GR%20with%20storage%20cedar%20and%20step.webp' },
];
---

<ServiceLayout
  title="Bespoke Garden Rooms Surrey | Fully Custom Garden Buildings | The Green Rooms"
  description="Fully bespoke garden rooms, studios and garden buildings designed and built across Surrey. Any shape, any size, any specification. Free design consultation and site visit."
  canonical="/garden-rooms/bespoke"
  heroImg="/images/Hero%20Bespoke%20build.webp"
  heroAlt="Bespoke custom garden room designed and built by The Green Rooms, Surrey"
  h1="Bespoke Garden Rooms"
  tagline="Fully Custom Garden Buildings — Surrey & South East"
  intro="When your garden, your vision, or your requirements don't fit a standard product — bespoke is the answer. We design and build completely custom garden structures from scratch: any shape, any footprint, any combination of materials. Whether it's an L-shaped office, a soundproofed music studio, a garden gym, or something entirely unique, we start with a blank page and build around you."
  features={features}
  relatedPages={related}
>

  <!-- Photo gallery -->
  <section style="background:#f8faf7; padding:72px 0 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.4rem,2.5vw,1.8rem); font-weight:700; color:#2d3841; margin:0 0 24px;">Bespoke Builds</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:280px;"><img src="/images/bespoke%20build%20close%20up%20hero.webp" alt="Bespoke garden room close up" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:280px;"><img src="/images/GR%20bespoke%20glass%20corner%20millboard.webp" alt="Bespoke garden room with glass corner and millboard" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:280px;"><img src="/images/HERO%20Bespoke%20garden%20room%20end%20of%20garden.webp" alt="Bespoke garden room at end of garden" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/bespoke%20shelter%20hot%20tub.webp" alt="Bespoke shelter with hot tub" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/bespoke%20build%20with%20canteen%20shutter.webp" alt="Bespoke build with canteen shutter" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/bespoke%20shape%20GP.webp" alt="Bespoke shaped garden pod" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:72px;">
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/bespoke%20shelter.webp" alt="Bespoke garden room shelter" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/Bespoke%204m%20bifolds.webp" alt="Bespoke garden room with 4m bifold doors" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/bespoke%20build%20with%203.6m%20sliding%20doors.webp" alt="Bespoke garden room with 3.6m sliding doors" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section" style="background:#fff;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin-bottom:10px;">What We've Built</h2>
        <p style="color:#666; max-width:480px; margin:0 auto;">A few examples of bespoke projects — every one started as a conversation about what was possible.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(2,1fr); gap:24px;">
        {useCases.map(u => (
          <div style="background:#f8faf7; border-radius:16px; overflow:hidden; border:1px solid #ebeced; display:flex; gap:0; flex-direction:column;">
            <img src={u.img} alt={u.title + ' by The Green Rooms'} style="width:100%; height:200px; object-fit:cover;" loading="lazy" />
            <div style="padding:24px;">
              <h3 style="font-size:1.05rem; font-weight:700; color:#2d3841; margin:0 0 8px;">{u.title}</h3>
              <p style="font-size:13.5px; color:#666; line-height:1.65; margin:0;">{u.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="background:#f8faf7;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin-bottom:10px;">How the Bespoke Process Works</h2>
      </div>
      <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:20px;">
        {[
          { step: '01', title: 'Free Site Visit', desc: 'We come to you, assess the garden, and listen to what you have in mind. No obligation.' },
          { step: '02', title: 'Design Proposal', desc: 'We draw up a detailed design with elevation drawings and a full specification.' },
          { step: '03', title: 'Quotation', desc: 'A precise, itemised quote — no vague estimates, no hidden extras.' },
          { step: '04', title: 'Build & Handover', desc: 'Our team builds your garden room in 2–3 weeks. We hand over the keys when you\'re happy.' },
        ].map(s => (
          <div style="background:#fff; border-radius:14px; padding:24px; border:1px solid #ebeced; text-align:center;">
            <div style="font-size:2rem; font-weight:800; color:#e7f1e3; margin-bottom:8px; font-family:'Poppins',sans-serif;">{s.step}</div>
            <p style="font-size:14px; font-weight:700; color:#2d3841; margin:0 0 6px;">{s.title}</p>
            <p style="font-size:13px; color:#666; line-height:1.6; margin:0;">{s.desc}</p>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:36px;">
        <a href="/contact-us" class="btn-primary">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

</ServiceLayout>
