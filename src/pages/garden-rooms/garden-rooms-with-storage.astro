---
import ServiceLayout from '../../components/ServiceLayout.astro';

const features = [
  { icon: 'door', title: 'Hidden Secret Door', desc: 'The storage entrance is clad to match the room\'s interior — almost invisible. Practical space without compromising the aesthetic.' },
  { icon: 'bifold', title: 'Aluminium Bifold Doors', desc: 'Full-width bifold doors on the main room open your space up to the garden.' },
  { icon: 'bulb', title: 'Canopy with LED Downlights', desc: 'Covered entrance with LED lighting — usable in all weathers, morning and evening.' },
  { icon: 'box', title: 'Integrated Storage Area', desc: 'A separate enclosed storage room built into the structure — garden tools, bikes, seasonal items kept out of sight.' },
  { icon: 'layers', title: 'SIPs Throughout', desc: 'The full structure — room and storage — uses structural insulated panels for strength and insulation.' },
  { icon: 'lightning', title: 'Full Electrics Included', desc: 'Mains connection, consumer unit, lighting, sockets, and a signed electrical certificate as standard.' },
  { icon: 'key', title: 'Fully Turnkey', desc: 'Foundations, structure, cladding, glazing, flooring, plastering, and site clean-up — all included.' },
  { icon: 'ruler', title: 'From 4m × 2.5m', desc: 'Minimum size to accommodate both the main room and a functional storage area.' },
];

const related = [
  { label: 'Garden Rooms', href: '/garden-rooms/garden-rooms', img: '/images/classic%20GR%20front%20on%20thermo%20ayous%20cladding.webp' },
  { label: 'Bespoke Garden Rooms', href: '/garden-rooms/bespoke', img: '/images/Hero%20Bespoke%20build.webp' },
  { label: 'Garden Offices', href: '/garden-rooms/garden-offices', img: '/images/GP%20office%20internal.webp' },
];
---

<ServiceLayout
  title="Garden Rooms with Storage Surrey | Secret Door Storage | The Green Rooms"
  description="Bespoke garden rooms with integrated hidden storage built across Surrey from £18,900 inc VAT. Bifold doors, canopy, SIPs construction, secret storage door. Free site visit."
  canonical="/garden-rooms/garden-rooms-with-storage"
  heroImg="/images/classic%20GR%20with%20storage%20and%20decking.webp"
  heroAlt="Garden room with integrated hidden storage built by The Green Rooms, Surrey"
  h1="Garden Rooms with Storage Surrey"
  tagline="Garden Rooms with Integrated Storage — Surrey & South East"
  price="From £18,900 inc VAT"
  intro="The smartest version of our standard garden room — everything you get with our Garden Room, plus a fully integrated storage area hidden behind a secret door clad to match the room's interior. You get a beautiful, functional living space and a place to keep the garden tidy, all in one footprint."
  features={features}
  relatedPages={related}
>

  <!-- Photo gallery -->
  <section style="background:#f8faf7; padding:72px 0 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.4rem,2.5vw,1.8rem); font-weight:700; color:#2d3841; margin:0 0 24px;">Garden Rooms with Storage We've Built</h2>
      <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:300px;"><img src="/images/GR%20with%20storage%20cedar%20and%20step%20doors%20open.webp" alt="Garden room with storage, cedar cladding, doors open" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:300px;"><img src="/images/hidden%20storage%20room.webp" alt="Hidden storage room door on garden room" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:300px;"><img src="/images/hidden%20storage%20internal%20view.webp" alt="Inside the hidden storage room" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/GR%20with%20storage%20with%204m%20sliding%20doors%20millboard%20cladding%20in%20ebony%20grey.webp" alt="Garden room with storage, millboard cladding, 4m sliding doors" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/hidden%20storage%20cedar.webp" alt="Hidden storage with cedar cladding" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/classic%20GR%20with%20storage%20and%20decking.webp" alt="Classic garden room with storage and millboard decking" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:72px;">
        <div style="border-radius:14px; overflow:hidden; height:200px;"><img src="/images/GR%20with%20storage%20cedar%20and%20step.webp" alt="Garden room with storage and cedar cladding" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:200px;"><img src="/images/GR%20with%20storage%20with%204m%20sliding%20doors%20millboard%20cladding%20in%20ebony%20grey%20portrait.webp" alt="Garden room with storage portrait view" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <section class="section" style="background:#fff;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="background:#f8faf7; border-radius:20px; padding:40px; border:1px solid #ebeced; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;">
        <div>
          <h2 style="font-size:1.5rem; font-weight:700; color:#2d3841; margin-bottom:12px;">The Secret Door</h2>
          <p style="font-size:1rem; color:#666; line-height:1.8; margin-bottom:16px;">Our signature detail — a storage access door clad in the same material as the surrounding wall. From the outside it looks like a seamless panel. Push it and it opens to a full storage room behind.</p>
          <p style="font-size:1rem; color:#666; line-height:1.8;">It solves the perennial problem of garden storage without the eyesore of a separate shed, and without using up more garden space. One structure, two purposes.</p>
        </div>
        <img
          src="/images/hidden%20storage%20with%20door%20closed%20millboard%20cladding%20external%20view.webp"
          alt="Secret storage door on a garden room by The Green Rooms, Surrey"
          style="width:100%; border-radius:14px;"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-size:clamp(1.4rem,3vw,1.9rem); font-weight:700; color:#fff; margin-bottom:14px;">Get a Price for Your Garden Room with Storage</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px;">Use our instant calculator to configure your build and see a guide price — including the hidden storage option. No email needed to see your estimate.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-white" style="font-size:15px; padding:14px 32px;">Get an Instant Quote</a>
        <a href="/contact-us" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

</ServiceLayout>
