---
import ServiceLayout from '../../components/ServiceLayout.astro';

const features = [
  { icon: 'bifold', title: 'Aluminium Bifold Doors', desc: 'Grand aluminium bifold doors that open the full front of the room — connecting your garden room to your garden seamlessly.' },
  { icon: 'bulb', title: 'Canopy with LED Lighting', desc: 'Elegant front canopy with LED downlights, creating covered outdoor space and making the room usable morning to evening.' },
  { icon: 'layers', title: 'Premium Visual Cladding', desc: 'Front wall and canopy underside finished in your choice of premium cladding. Other walls in durable, zero-maintenance metal cladding.' },
  { icon: 'window', title: 'Slot Window', desc: 'A sleek aluminium slot window brings in side light without compromising privacy or wall space.' },
  { icon: 'layers', title: 'SIPs Construction', desc: 'Full structural insulated panel build throughout. Warm in winter, cool in summer, and properly soundproofed.' },
  { icon: 'lightning', title: 'Full Electrics Included', desc: 'Mains connection, consumer unit, lighting, sockets, and a signed electrical certificate as standard.' },
  { icon: 'key', title: 'Fully Turnkey', desc: 'Foundations, structure, cladding, glazing, flooring, plastering, and site clean-up all included.' },
  { icon: 'ruler', title: 'Sizes From 4m × 2.5m', desc: 'Medium to large builds designed to make the most of your available garden space.' },
];

const related = [
  { label: 'Garden Rooms with Storage', href: '/garden-rooms/garden-rooms-with-storage', img: '/images/GR%20with%20storage%20cedar%20and%20step.webp' },
  { label: 'Garden Offices', href: '/garden-rooms/garden-offices', img: '/images/GP%20office%20internal.webp' },
  { label: 'Bespoke Garden Rooms', href: '/garden-rooms/bespoke', img: '/images/Hero%20Bespoke%20build.webp' },
];

const faqs = [
  {
    q: "What's the difference between a garden room and a conservatory?",
    a: "A garden room is a fully insulated, year-round structure with its own electrical installation — built to the same standard as a house extension. A conservatory is primarily glazed, loses heat in winter and overheats in summer, and typically has planning restrictions of its own. A garden room costs less than a full extension, doesn't require party wall agreements, and is usually built under Permitted Development. It adds more usable space per pound spent."
  },
  {
    q: "Does a garden room need planning permission?",
    a: "Most garden rooms fall under Permitted Development — no planning permission required. The rules cover footprint (no more than 50% of the garden), height (single storey, max 2.5m within 2m of a boundary), and position (not forward of the principal elevation). Listed buildings and conservation areas may require consent. We confirm your position at the <a href='/contact-us' style='color:#34a02e;font-weight:600;'>free site visit</a> — and if there's any doubt, we'll advise on obtaining a Certificate of Lawful Development."
  },
  {
    q: "Is a garden room worth the investment?",
    a: "In almost every case, yes. A well-built garden room adds 5–15% to property value — often significantly more than the construction cost. Beyond the financial return, it transforms how you use your home: a separate space for work, hobbies, fitness or entertaining that doesn't consume indoor rooms. Many of our customers tell us it's the best money they've spent on the house. See our <a href='/testimonials' style='color:#34a02e;font-weight:600;'>reviews</a> for first-hand accounts."
  },
  {
    q: "Can I use a garden room all year round?",
    a: "<a href='/your-build/structure' style='color:#34a02e;font-weight:600;'>SIPs construction</a> gives you genuine year-round insulation — the same panel system used in Passivhaus buildings. With a smart panel heater (or air conditioning for summer cooling), a garden room is comfortable in every season. Every garden room in our standard range is designed and built to the same year-round specification — there's no 'summer use only' version."
  },
  {
    q: "Can a garden room be used as a guest bedroom?",
    a: "Yes, many of our customers use their garden room as overflow guest accommodation. We'd recommend sizing to at least 4×3m for a comfortable bedroom with a seating area. You'll also want to consider: a toilet or shower room (we can include a WC in a bespoke build), window blinds or curtains for privacy, and heating that can be set on a timer. For a dedicated annexe with sleeping accommodation, see our <a href='/garden-rooms/bespoke' style='color:#34a02e;font-weight:600;'>bespoke</a> options."
  },
  {
    q: "How does a garden room compare to a summer house?",
    a: "A summer house is typically a thin-walled timber structure with minimal insulation — suitable for a few months a year. Our garden rooms are built with SIPs panels, A-rated glazing, and a full electrical installation. They're insulated to a higher standard than many brick-and-mortar extensions, and are designed to be used every day of the year. The price difference reflects the quality difference."
  },
];
---

<ServiceLayout
  title="Garden Rooms Surrey | Luxury Garden Rooms from £16,950 | The Green Rooms"
  description="Luxury bespoke garden rooms built across Surrey from £16,950 inc VAT. Aluminium bifold doors, canopy, SIPs construction, full electrics — turnkey installation. Free site visit."
  canonical="/garden-rooms/garden-rooms"
  heroImg="/images/Hero%20GR.webp"
  heroAlt="Luxury bespoke garden room built by The Green Rooms, Surrey"
  h1="Garden Rooms Surrey"
  tagline="Luxury Garden Rooms — Surrey & South East"
  price="From £16,950 inc VAT"
  intro="Our Garden Rooms are the most versatile structure we build — equally at home as an entertainment space, a creative studio, a home bar, or simply your favourite room in the house. They come with grand aluminium bifold doors, a canopy with LED lighting, and a premium cladding finish as standard. These are rooms designed to be used and enjoyed, not just looked at."
  features={features}
  relatedPages={related}
  faqs={faqs}
  projects={[
    { slug: 'garden-office-with-storage-farnham', label: 'Garden Office with Storage — Farnham', tagline: 'Farnham · Cedar cladding · Bifold doors · Carpet flooring · Integrated storage room', img: '/images/ollie-garden-office-1.webp' },
    { slug: 'compact-garden-pod-caroline', label: 'Compact Garden Pod — Caroline', tagline: 'Surrey · Hardie Plank Arctic White · UPVC sliding doors · Compact office pod', img: '/images/caroline-pod-2.webp' },
  ]}
>

  <section class="section" style="background:#fff;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
        <img
          src="/images/GR%20at%20night%20charred%20spruce%20crittal%20french%20doors.webp"
          alt="Garden room at night with LED canopy lighting, Surrey"
          style="width:100%; border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,0.1);"
          loading="lazy"
        />
        <div>
          <h2 style="font-size:clamp(1.5rem,2.5vw,2rem); font-weight:700; color:#2d3841; margin-bottom:16px;">Whatever You Want It to Be</h2>
          <p style="font-size:1rem; color:#666; line-height:1.8; margin-bottom:20px;">The beauty of a garden room with bifold doors is that it blurs the line between indoors and outdoors. Open them up on a summer evening and you have an extension of your garden. Close them on a January afternoon and you have a warm, insulated, light-filled room with nowhere else quite like it.</p>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:10px;">
            {['Entertainment lounge', 'Home gym', 'Games room', 'Art or music studio', 'Home bar', 'Cinema room', 'Yoga or wellness space', 'Guest room'].map(use => (
              <div style="display:flex; align-items:center; gap:8px; font-size:13px; font-weight:600; color:#2d3841;">
                <svg width="14" height="14" fill="#34a02e" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                {use}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Photo gallery -->
  <section style="background:#f8faf7; padding:72px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.4rem,2.5vw,1.8rem); font-weight:700; color:#2d3841; margin:0 0 24px;">Garden Rooms We've Built</h2>
      <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:320px;"><img src="/images/GR%20dual%20canopy%20blinds%20glass%20corner.webp" alt="Garden room with dual canopy and glass corner" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:320px;"><img src="/images/GR%20internal%20with%20bifolds%20and%20decorated.webp" alt="Garden room interior with bifold doors" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:320px;"><img src="/images/GR%20end%20of%20garden%202.webp" alt="Garden room at end of garden, Surrey" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 2fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/night%20lighting.webp" alt="Garden room with exterior lighting at night" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/GR%20glass%20corner%20dual%20canopy.webp" alt="Garden room with glass corner and canopy" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:240px;"><img src="/images/GR%20with%20cedar%20cladding%20Nordlux%20kyclop%20ripple%20wall%20light.webp" alt="Garden room with cedar cladding and wall lighting" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px; margin-bottom:72px;">
        <div style="border-radius:14px; overflow:hidden; height:180px;"><img src="/images/GR%20charred%20spruce.webp" alt="Garden room with charred spruce cladding" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:180px;"><img src="/images/Classic%20GR%20in%20Garden.webp" alt="Classic garden room in a Surrey garden" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:180px;"><img src="/images/GR%20extended%20height%20with%20thermo%20ayous%20cladding%20and%20millboard%20decking%20opposite%20angle.webp" alt="Extended height garden room with millboard decking" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:180px;"><img src="/images/winter%20shot%20of%20GR.webp" alt="Garden room in winter" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- Garden Room vs Conservatory / Extension -->
  <section class="section" style="background:#fff;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin-bottom:10px;">Garden Room vs Conservatory vs Extension</h2>
        <p style="color:#666; max-width:540px; margin:0 auto;">The honest comparison most companies don't make.</p>
      </div>
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse; min-width:600px;">
          <thead>
            <tr>
              <th style="padding:14px 20px; text-align:left; background:#f8faf7; font-size:12px; color:#888; font-weight:700; border-bottom:2px solid #ebeced;"></th>
              <th style="padding:14px 20px; text-align:center; background:#f8faf7; font-size:13px; color:#2d3841; font-weight:700; border-bottom:2px solid #ebeced;">Garden Room</th>
              <th style="padding:14px 20px; text-align:center; background:#f8faf7; font-size:13px; color:#2d3841; font-weight:700; border-bottom:2px solid #ebeced;">Conservatory</th>
              <th style="padding:14px 20px; text-align:center; background:#f8faf7; font-size:13px; color:#2d3841; font-weight:700; border-bottom:2px solid #ebeced;">Extension</th>
            </tr>
          </thead>
          <tbody>
            {[
              ['Planning permission', 'Usually no', 'Usually no', 'Almost always yes'],
              ['Build time', '2–3 weeks', '4–8 weeks', '12–20 weeks'],
              ['Year-round comfort', '✓ Excellent', '✗ Hot in summer, cold in winter', '✓ Excellent'],
              ['Disruption to home', 'Minimal — garden only', 'Moderate', 'High — walls opened up'],
              ['Starting cost', 'From £16,950', 'From £15,000', 'From £40,000+'],
              ['Adds property value', '5–15%', '5–7%', '10–20%'],
              ['Separate from home', '✓ Yes — genuinely private', '✗ Attached', '✗ Attached'],
            ].map((row, i) => (
              <tr style={i % 2 === 0 ? 'background:#fff;' : 'background:#fafbf9;'}>
                <td style="padding:14px 20px; font-size:13px; font-weight:700; color:#2d3841; border-bottom:1px solid #ebeced;">{row[0]}</td>
                <td style="padding:14px 20px; font-size:13px; color:#34a02e; font-weight:600; text-align:center; border-bottom:1px solid #ebeced;">{row[1]}</td>
                <td style="padding:14px 20px; font-size:13px; color:#888; text-align:center; border-bottom:1px solid #ebeced;">{row[2]}</td>
                <td style="padding:14px 20px; font-size:13px; color:#888; text-align:center; border-bottom:1px solid #ebeced;">{row[3]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Planning permission -->
  <section class="section" style="background:#f8faf7;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:start;">
        <div>
          <div style="display:inline-block; background:#e7f1e3; color:#257a21; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:5px 14px; border-radius:50px; margin-bottom:14px;">Good News</div>
          <h2 style="font-size:clamp(1.3rem,2.5vw,1.75rem); font-weight:700; color:#2d3841; margin-bottom:16px;">Most Garden Rooms Don't Need Planning Permission</h2>
          <p style="font-size:15px; color:#555; line-height:1.8; margin-bottom:14px;">Under Permitted Development rights, most garden rooms can be built without planning permission. The rules cover footprint, height and position — and the large majority of standard builds fall comfortably within them.</p>
          <p style="font-size:15px; color:#555; line-height:1.8; margin-bottom:20px;">We confirm your permitted development position at the free site visit. If there's any doubt, we'll discuss obtaining a Certificate of Lawful Development to give you total certainty before we start.</p>
          <a href="/your-build/first-steps" style="color:#34a02e; font-weight:600; font-size:14px; text-decoration:none;">Read our getting started guide →</a>
        </div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          {[
            { rule: 'Single storey only', ok: true },
            { rule: 'No more than 50% of garden covered', ok: true },
            { rule: 'Max 2.5m height within 2m of boundary', ok: true },
            { rule: 'Not forward of the principal elevation', ok: true },
            { rule: 'Listed buildings — check with us', ok: false },
            { rule: 'Conservation areas — check with us', ok: false },
          ].map(r => (
            <div style={`display:flex; align-items:center; gap:12px; padding:12px 16px; background:${r.ok ? '#fff' : '#fff8f8'}; border-radius:10px; border:1px solid ${r.ok ? '#ebeced' : '#f5e0e0'};`}>
              <svg width="16" height="16" fill={r.ok ? '#34a02e' : '#cc4444'} viewBox="0 0 24 24">{r.ok ? <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/> : <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>}</svg>
              <span style="font-size:13.5px; font-weight:600; color:#2d3841;">{r.rule}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section style="background:#fff; padding:72px 0; border-top:1px solid #ebeced;">
    <div style="max-width:900px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:32px;">
        <div style="display:flex; justify-content:center; gap:3px; margin-bottom:8px;">
          {[1,2,3,4,5].map(() => <svg width="20" height="20" fill="#f59e0b" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}
        </div>
        <p style="font-size:13px; color:#888; margin:0;">5.0 · 39 Google Reviews</p>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
        <blockquote style="background:#f8faf7; border-radius:16px; padding:28px; border:1px solid #ebeced; margin:0;">
          <p style="font-size:14.5px; color:#444; line-height:1.8; margin:0 0 16px; font-style:italic;">"We had a cinema room and home office designed and built. We have been using it for over a year now and still love it. The quality is exceptional and the workmanship is stunning. Very pleased we went with The Green Rooms!"</p>
          <footer style="font-size:13px; font-weight:700; color:#2d3841;">Kate Hardesty <span style="font-weight:400; color:#888;">· April 2024</span></footer>
        </blockquote>
        <blockquote style="background:#f8faf7; border-radius:16px; padding:28px; border:1px solid #ebeced; margin:0;">
          <p style="font-size:14.5px; color:#444; line-height:1.8; margin:0 0 16px; font-style:italic;">"The garden room was exceptional during the hot summer months. It remained cool and comfortable without any air conditioning, which was a pleasant surprise. James is a true professional and craftsman."</p>
          <footer style="font-size:13px; font-weight:700; color:#2d3841;">V Barman <span style="font-weight:400; color:#888;">· June 2023</span></footer>
        </blockquote>
      </div>
      <p style="text-align:center; margin:20px 0 0;"><a href="/testimonials" style="color:#34a02e; font-size:13.5px; font-weight:600; text-decoration:none;">Read all 39 reviews →</a></p>
    </div>
  </section>

  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-size:clamp(1.4rem,3vw,1.9rem); font-weight:700; color:#fff; margin-bottom:14px;">See What Your Garden Room Would Cost</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px;">Configure your size, roof, cladding, doors and extras and get a guide price instantly.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-white" style="font-size:15px; padding:14px 32px;">Get an Instant Quote</a>
        <a href="/contact-us" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

</ServiceLayout>

<style>
  @media (max-width: 900px) {
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; gap: 32px !important; }
    div[style*="grid-template-columns:2fr 1fr 1fr"] { grid-template-columns: 1fr 1fr !important; }
    div[style*="grid-template-columns:1fr 1fr 2fr"] { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:2fr 1fr 1fr"],
    div[style*="grid-template-columns:1fr 1fr 2fr"],
    div[style*="grid-template-columns:1fr 1fr 1fr 1fr"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
