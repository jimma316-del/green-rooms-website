---
import ServiceLayout from '../../components/ServiceLayout.astro';

const features = [
  { icon: 'ruler', title: 'Extended Height Structure', desc: 'Minimum 3m internal height — essential for a full golf swing without restriction. Single or dual pitch roof options available.' },
  { icon: 'award', title: 'Partnership with Golf Swing Systems', desc: 'We work exclusively with Golf Swing Systems, industry experts with over 20 years in golf simulation technology, to specify and install every simulator.' },
  { icon: 'network', title: 'Launch Monitor Integration', desc: 'Every system is matched to the right launch monitor for your game and budget — from entry-level to professional-grade.' },
  { icon: 'tools', title: 'Full Technology Setup', desc: 'Projector, screen, turf mat, wall protection, gaming PC, and launch monitor — fully specified and installed as one package.' },
  { icon: 'soundwave', title: 'SIPs Soundproofing', desc: 'Structural insulated panels keep impact noise in and weather noise out — essential for a realistic simulation experience.' },
  { icon: 'lightning', title: 'Dedicated Electrical Circuit', desc: 'High-spec electrical installation with dedicated circuits for simulation equipment, lighting and heating.' },
];

const packages = [
  {
    name: 'Option 1 — Budget-Friendly',
    price: 'From £15,000',
    desc: 'Entry-level launch monitor, projector and screen setup. A great starting point for practice at home.',
    includes: ['Entry-level launch monitor', 'Projector & impact screen', 'Artificial turf hitting mat', 'Golf simulation software', 'Wall protection padding', 'Gaming PC setup'],
  },
  {
    name: 'Option 2 — Mid-Range',
    price: 'From £22,500',
    desc: 'Upgraded launch monitor with improved accuracy and course simulation. The most popular choice.',
    includes: ['Mid-range launch monitor', 'High-brightness projector', 'Premium impact screen', 'Pro turf hitting mat', 'Wall & side protection', 'Gaming PC with premium software', '100+ course library'],
  },
  {
    name: 'Option 3 — Premium',
    price: 'From £37,500',
    desc: 'Professional-grade technology. The closest experience to a real course you can get at home.',
    includes: ['Professional launch monitor', 'Ultra-bright 4K projector', 'High-res premium screen', 'Pro hitting bay & mat', 'Full surround protection', 'High-spec gaming PC', '200+ course library', 'Club fitting integration'],
  },
];

const related = [
  { label: 'Bespoke Garden Rooms', href: '/garden-rooms/bespoke', img: '/images/Hero%20Bespoke%20build.webp' },
  { label: 'Garden Rooms', href: '/garden-rooms/garden-rooms', img: '/images/classic%20GR%20front%20on%20thermo%20ayous%20cladding.webp' },
  { label: 'Garden Offices', href: '/garden-rooms/garden-offices', img: '/images/GP%20office%20internal.webp' },
];

const faqs = [
  {
    q: "Does a golf simulator room need planning permission?",
    a: "An extended-height golf simulator studio usually falls under Permitted Development — the same rules as any outbuilding. The structure must not exceed 4m in height with a dual-pitched roof (or 3m elsewhere), must not cover more than 50% of the garden, and must be single storey. Because our simulator studios often use a dual-pitched roof to achieve 3m+ internal height, this typically keeps the eave height within Permitted Development rules. We confirm your position at the free consultation — listed buildings and conservation areas are assessed separately."
  },
  {
    q: "What are the minimum room dimensions for a golf simulator?",
    a: "For a comfortable full-swing setup, we recommend a minimum of 4m wide — ideally 4.5m to give clearance for both left and right handed players. Minimum depth is around 5m, though this depends on the launch monitor you choose, as some require more distance between ball position and screen. Internal height needs to be at least 2.8m; a standard garden room won't cut it. We build extended-height structures specifically for this use. We'll confirm the ideal dimensions for your space and simulator package at the free site visit."
  },
  {
    q: "What is the total budget for a golf simulator garden room?",
    a: "Most clients invest between £38,000 and £55,000 in total — this covers the garden room structure (priced using our <a href='/garden-room-price-calculator' style='color:#34a02e;font-weight:600;'>calculator</a>) plus the simulator technology package. The structure typically runs from £18,000–£25,000 for an extended-height build with appropriate electrics, and the simulator package adds £15,000–£37,500 depending on the technology tier. We'll give you a combined quote at the free consultation."
  },
  {
    q: "Can the room be used for anything other than golf?",
    a: "Yes — many of our simulator studio customers use the space in multiple ways. The extended height and large floor area make it ideal for other sports simulation (cricket, football), as a home cinema when the simulator isn't in use, or as a general entertainment or games room. The rubber flooring can also support gym equipment. We'll design the room around your full list of uses."
  },
  {
    q: "How accurate are home golf simulators?",
    a: "Modern launch monitors are highly accurate — mid-range and premium systems track spin rate, launch angle, ball speed and club path to within a few percent of what you'd see with professional equipment on a real course. Our technology partner Golf Swing Systems has over 20 years of experience and will spec the right system for your game and your expectations. Entry-level systems are excellent for practice; premium systems are used by touring professionals."
  },
];
---

<ServiceLayout
  title="Golf Simulator Garden Rooms Surrey | Golf Simulator Studios | The Green Rooms"
  description="Custom golf simulator garden rooms built across Surrey. Extended height SIPs studios in partnership with Golf Swing Systems. Three packages from £15,000. Free consultation."
  canonical="/garden-rooms/golf-simulator-studios"
  heroImg="/images/HERO%20Golf%20sim.webp"
  heroAlt="Golf simulator garden room built by The Green Rooms in partnership with Golf Swing Systems"
  h1="Golf Simulator Studios Surrey"
  tagline="Custom Golf Simulator Garden Rooms — Surrey & South East"
  intro="Practice your game in a purpose-built, extended-height garden studio — any time, in any weather, without leaving home. We design and build the structure; our partners Golf Swing Systems specify and install the technology. Together, we deliver a complete, ready-to-play golf simulator room from a single point of contact."
  features={features}
  relatedPages={related}
  faqs={faqs}
  projects={[
    { slug: 'golf-simulator-woking', label: 'Golf Simulator Studio — Woking', tagline: 'Woking · Full planning permission · 3.7m height · Millboard board & batten · Foresight Sports', img: '/images/jc-golf-sim-night.webp' },
  ]}
>

  <!-- Photo gallery -->
  <section style="background:#f8faf7; padding:72px 0 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.4rem,2.5vw,1.8rem); font-weight:700; color:#2d3841; margin:0 0 24px;">Golf Simulator Studios We've Built</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:280px;"><img src="/images/Golf%20sim%20setup%20hero.webp" alt="Golf simulator studio setup" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:280px;"><img src="/images/golf%20sim%20internal%20action%20shot.webp" alt="Golf simulator in action inside garden room" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:280px;"><img src="/images/HERO%20extended%20height%20golf%20sim%20millboard%20board%20and%20batten%20in%20anthracite.webp" alt="Extended height golf simulator garden room" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:72px;">
        <div style="border-radius:14px; overflow:hidden; height:260px;"><img src="/images/night%20lighting%20extended%20height%20golf%20sim%20millboard%20board%20and%20batten%20in%20anthracite.webp" alt="Golf simulator garden room at night with lighting" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:260px;"><img src="/images/extended%20height%20golf%20sim%20close%20up%20millboard%20board%20and%20batten%20in%20anthracite.webp" alt="Close up of extended height golf simulator garden room" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- Room dimensions -->
  <section class="section" style="background:#fff;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:36px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin-bottom:10px;">Room Dimensions That Matter</h2>
        <p style="color:#666; max-width:520px; margin:0 auto;">A golf simulator studio is one structure where dimensions are non-negotiable. Here's what you need to know before design.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px; max-width:860px; margin:0 auto 32px;">
        {[
          {
            label: 'Minimum Width',
            value: '4m',
            detail: 'Ideally 4.5m — this gives comfortable clearance for both left and right handed players without compromise.',
          },
          {
            label: 'Minimum Depth',
            value: '5m',
            detail: 'The exact depth depends on your launch monitor — some need more distance from screen to ball position than others.',
          },
          {
            label: 'Internal Height',
            value: '2.8m+',
            detail: 'A standard garden room sits around 2.15m internally. We build extended-height structures specifically to hit the 2.8m+ needed for a full swing.',
          },
        ].map(d => (
          <div style="background:#f8faf7; border-radius:16px; padding:28px; border:1px solid #ebeced; text-align:center;">
            <p style="font-size:12px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 8px;">{d.label}</p>
            <p style="font-size:2.5rem; font-weight:800; color:#2d3841; margin:0 0 12px; font-family:'Poppins',sans-serif; line-height:1;">{d.value}</p>
            <p style="font-size:13px; color:#666; line-height:1.65; margin:0;">{d.detail}</p>
          </div>
        ))}
      </div>
      <div style="max-width:860px; margin:0 auto;">
        <div style="background:#e7f1e3; border-radius:14px; padding:20px 24px; display:flex; align-items:flex-start; gap:14px;">
          <svg width="20" height="20" fill="#34a02e" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:1px;"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
          <p style="font-size:13.5px; color:#257a21; margin:0; line-height:1.7;"><strong>Planning:</strong> We can achieve all these dimensions within Permitted Development rules if your space allows. If planning permission is needed, we handle the application for you through our specialist planning consultant.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Simulator packages -->
  <section class="section" style="background:#f8faf7;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin-bottom:10px;">Simulator Packages</h2>
        <p style="color:#666; max-width:580px; margin:0 auto 16px;">Prices below are for the simulator technology only. The garden room structure is quoted separately — most clients invest <strong style="color:#2d3841;">£38,000–£55,000 in total</strong> (structure plus technology). Use our <a href="/garden-room-price-calculator" style="color:#34a02e; font-weight:600;">price calculator</a> for a structure estimate, then choose your package below.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:24px;">
        {packages.map((pkg, i) => (
          <div style={`background:#fff; border-radius:16px; padding:28px; border:2px solid ${i === 1 ? '#34a02e' : '#ebeced'}; position:relative; display:flex; flex-direction:column;`}>
            {i === 1 && <div style="position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:#34a02e; color:#fff; font-size:11px; font-weight:700; padding:4px 14px; border-radius:50px; white-space:nowrap;">Most Popular</div>}
            <p style="font-size:13px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.06em; margin:0 0 8px;">{pkg.name}</p>
            <p style="font-size:1.75rem; font-weight:700; color:#2d3841; margin:0 0 12px;">{pkg.price}</p>
            <p style="font-size:13.5px; color:#666; line-height:1.65; margin:0 0 20px;">{pkg.desc}</p>
            <div style="border-top:1px solid #f0f0f0; padding-top:16px; margin-top:auto;">
              <p style="font-size:11px; font-weight:700; color:#2d3841; text-transform:uppercase; letter-spacing:0.07em; margin:0 0 10px;">What's included</p>
              <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:6px;">
                {pkg.includes.map(item => (
                  <li style="display:flex; align-items:flex-start; gap:8px; font-size:12.5px; color:#555;">
                    <svg width="12" height="12" fill="#34a02e" viewBox="0 0 24 24" style="flex-shrink:0; margin-top:2px;"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align:center; font-size:13px; color:#999; margin-top:20px;">All prices exclude VAT. Garden room structure priced separately. Contact us for a full combined quote.</p>
    </div>
  </section>

  <!-- Golf Swing Systems partnership -->
  <section class="section" style="background:#fff;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;">
        <div>
          <h2 style="font-size:clamp(1.5rem,2.5vw,2rem); font-weight:700; color:#2d3841; margin-bottom:16px;">Our Technology Partner</h2>
          <p style="font-size:1rem; color:#666; line-height:1.8; margin-bottom:16px;">We partner exclusively with <strong>Golf Swing Systems</strong> — one of the UK's leading golf simulation specialists with over 20 years of experience. They handle every aspect of the technology: selection, installation, configuration, and ongoing support.</p>
          <p style="font-size:1rem; color:#666; line-height:1.8; margin-bottom:24px;">Whatever your budget, your game demands, or your preferred technology, Golf Swing Systems will spec the right setup for you. We build the room around it.</p>
          <a href="/contact-us" class="btn-primary">Book a Free Consultation</a>
        </div>
        <img
          src="/images/golf%20sim%20internal%20action%20shot.webp"
          alt="Golf simulator in action inside a garden room studio by The Green Rooms"
          style="width:100%; border-radius:16px; box-shadow:0 8px 32px rgba(0,0,0,0.1);"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section style="background:#f8faf7; padding:72px 0; border-top:1px solid #ebeced;">
    <div style="max-width:760px; margin:0 auto; padding:0 24px; text-align:center;">
      <div style="display:flex; justify-content:center; gap:3px; margin-bottom:16px;">
        {[1,2,3,4,5].map(() => <svg width="20" height="20" fill="#f59e0b" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}
      </div>
      <blockquote style="margin:0 0 20px;">
        <p style="font-size:16px; color:#444; line-height:1.85; margin:0 0 16px; font-style:italic;">"Excellent experience from start to finish. The golf simulator room is exceptional — James and the team designed the perfect extended-height structure and the Golf Swing Systems installation is incredible. I use it every day, rain or shine. Can't recommend highly enough."</p>
        <footer style="font-size:13.5px; font-weight:700; color:#2d3841;">Stephen Rodgers <span style="font-weight:400; color:#888;">· March 2024</span></footer>
      </blockquote>
      <a href="/testimonials" style="color:#34a02e; font-size:13.5px; font-weight:600; text-decoration:none;">Read all 39 reviews →</a>
    </div>
  </section>

</ServiceLayout>

<style>
  @media (max-width: 900px) {
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; gap: 32px !important; }
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
