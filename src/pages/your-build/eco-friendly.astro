---
import InfoLayout from '../../layouts/InfoLayout.astro';
import Icon from '../../components/Icon.astro';
---
<InfoLayout
  title="Eco-Friendly Garden Rooms | Sustainable Build | The Green Rooms Surrey"
  description="How The Green Rooms builds sustainably — FSC and PEFC certified timber, ground screw foundations, SIPs energy efficiency, and low-impact construction methods."
  canonical="/your-build/eco-friendly"
  pageTitle="Eco-Friendly Builds"
  pageSubtitle="Sustainability built into every project — not as a marketing claim, but as a practical specification choice."
  heroImg="/images/GR%20charred%20spruce%20in%20garden.webp"
  heroAlt="Charred spruce clad garden room in a Surrey garden"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Your Build', href: '/your-build/build-process' }, { label: 'Eco Friendly' }]}
>
  <section style="background:#fff; padding:72px 0;">
    <div style="max-width:840px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:48px;">
        {[
          { icon: 'leaf',        title: 'FSC Certified Timber', desc: 'Every piece of structural timber in our builds is sourced from FSC (Forest Stewardship Council) certified suppliers — forests managed to strict environmental and social standards.' },
          { icon: 'shield',      title: 'PEFC Certified Timber', desc: 'We also hold PEFC certification — an additional Programme for the Endorsement of Forest Certification. This covers the full chain of custody from forest to finished build.' },
          { icon: 'tools',       title: 'Ground Screw Foundations', desc: 'Ground screws are drilled into the ground with no concrete — meaning minimal excavation, no spoil removal, and a foundation that leaves the ground largely undisturbed and reversible.' },
          { icon: 'layers',      title: 'SIPs Energy Efficiency', desc: 'Structural Insulated Panels deliver exceptional thermal performance — reducing the heating energy your garden room requires year-round. A SIPs room uses significantly less energy than a timber-stud equivalent.' },
          { icon: 'check',       title: 'Site Waste Removal', desc: "Full site clean-up is included in every build. All construction waste is responsibly disposed of — we don't leave skips on your drive or material in your garden." },
          { icon: 'certificate', title: 'No Tropical Hardwoods', desc: "All cladding timber options come from European or North American certified sources. We don't specify tropical hardwoods, which are often sourced from unsustainable logging operations." },
        ].map(e => (
          <div style="background:#f8faf7; border-radius:16px; padding:24px; border:1px solid #ebeced;">
            <div style="width:40px; height:40px; background:#34a02e; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <Icon name={e.icon} size={20} color="#fff" />
            </div>
            <h3 style="font-size:13px; font-weight:700; color:#2d3841; margin:0 0 8px;">{e.title}</h3>
            <p style="font-size:13px; color:#555; line-height:1.7; margin:0;">{e.desc}</p>
          </div>
        ))}
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:32px;">
        <div style="border-radius:12px; overflow:hidden; height:200px;"><img src="/images/GR%20charred%20spruce%20in%20garden.webp" alt="Garden room with sustainable charred spruce cladding" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:12px; overflow:hidden; height:200px;"><img src="/images/GR%20extended%20height%20with%20thermo%20ayous%20cladding%20and%20millboard%20decking.webp" alt="Garden room with FSC certified thermo ayous cladding and composite decking" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:12px; overflow:hidden; height:200px;"><img src="/images/Classic%20GR%20in%20Garden.webp" alt="Classic garden room set in a Surrey garden" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>

      <div style="background:#2d3841; border-radius:16px; padding:28px; margin-bottom:32px;">
        <h3 style="font-size:1rem; font-weight:700; color:#fff; margin:0 0 12px;">A Note on "Eco" Claims in the Industry</h3>
        <p style="font-size:13.5px; color:rgba(255,255,255,0.75); line-height:1.8; margin:0 0 12px;">Many garden room companies market their products as "eco-friendly" without specifying what that means in practice. Common claims — "low energy," "sustainable materials" — often aren't backed by timber certification, independent standards or meaningful specification changes.</p>
        <p style="font-size:13.5px; color:rgba(255,255,255,0.75); line-height:1.8; margin:0;">We prefer to be specific: FSC and PEFC certification, ground screw foundations, SIPs U-values, and certified site waste disposal. Ask any builder you're considering to be equally specific.</p>
      </div>

      <div style="background:#34a02e; border-radius:20px; padding:28px; text-align:center;">
        <h3 style="font-size:1.05rem; font-weight:700; color:#fff; margin:0 0 10px;">Any Questions About Our Specification?</h3>
        <p style="font-size:13.5px; color:rgba(255,255,255,0.85); margin:0 0 16px;">We're happy to share our timber certification documentation and discuss any aspect of our build specification in detail.</p>
        <a href="/contact-us" class="btn-white" style="font-size:14px; padding:12px 24px;">Get in Touch</a>
      </div>
    </div>
  </section>
</InfoLayout>
<style>
  @media (max-width: 700px) {
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
