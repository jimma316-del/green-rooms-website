---
import InfoLayout from '../layouts/InfoLayout.astro';
import Icon from '../components/Icon.astro';

const team = [
  { name: 'James', role: 'Owner & Principal Designer', img: '/images/Team%20Photos/James.png' },
  { name: 'Natasha', role: 'Operations Manager', img: '/images/Team%20Photos/Natasha.jpg', pos: 'center center' },
  { name: 'Luke', role: 'Site Manager', img: '/images/Team%20Photos/Luke.png' },
  { name: 'Callum', role: 'Carpenter', img: '/images/Team%20Photos/Callum.png' },
  { name: 'Shane', role: 'Carpenter', img: '/images/Team%20Photos/Shane.png' },
  { name: 'James H', role: 'Installer', img: '/images/Team%20Photos/JamesH.jpg' },
  { name: 'Tim', role: 'Air Conditioning', img: '/images/Team%20Photos/Tim%202.jpeg', pos: '70% center' },
  { name: 'Vas', role: 'Electrician', img: '/images/Team%20Photos/VAS.jpg' },
  { name: 'Ryan', role: 'Electrician', img: '/images/Team%20Photos/Ryan.jpg' },
  { name: 'Charlie', role: 'Plasterer', img: '/images/Team%20Photos/Charlie.jpg' },
];

const values = [
  { icon: 'tools', title: 'Hand-Built, Every Time', desc: 'We are carpenters, not assemblers. Every garden room is built from scratch by our own skilled team — no subcontracting the core build.' },
  { icon: 'layers', title: 'No Shortcuts on Materials', desc: 'SIPs throughout, EPDM or metal roofing, 30+ year cladding options. We use what lasts — not what\'s cheapest.' },
  { icon: 'users', title: 'One Point of Contact', desc: 'From first site visit to final handover, you deal with the same team. No lost-in-translation handoffs.' },
  { icon: 'key', title: 'Fully Turnkey', desc: 'Foundations, structure, cladding, glazing, electrics, flooring, plastering, site clean-up. You unlock the door on day one.' },
  { icon: 'certificate', title: 'Honest Pricing', desc: 'No hidden extras. Our quotes are itemised and fixed — the price you agree is the price you pay.' },
  { icon: 'leaf', title: 'Sustainability Built In', desc: 'All timber is FSC and PEFC certified. Ground screw foundations leave zero concrete in the ground.' },
];
---

<InfoLayout
  title="About The Green Rooms | Bespoke Garden Room Builders Surrey"
  description="Founded in 2019 in Surrey, The Green Rooms is a small team of skilled carpenters building bespoke, hand-crafted garden rooms. Learn about our story, team and values."
  canonical="/about"
  pageTitle="About The Green Rooms"
  pageSubtitle="A small but mighty team of carpenters and designers based in Lyne, Surrey — building bespoke garden rooms since 2019."
  heroImg="/images/classic%20GR%20front%20on%20thermo%20ayous%20cladding.jpg"
  heroAlt="The Green Rooms showroom in Lyne, Surrey"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'About Us' }]}
>

  <!-- Story section -->
  <section style="background:#fff; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:center;">
      <div>
        <div style="display:inline-block; background:#e7f1e3; color:#257a21; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:5px 14px; border-radius:50px; margin-bottom:20px;">Our Story</div>
        <h2 style="font-size:clamp(1.5rem,3vw,2.2rem); font-weight:700; color:#2d3841; margin-bottom:20px; line-height:1.2;">Started in a Garden. Grown Into Something Bigger.</h2>
        <p style="font-size:1rem; color:#555; line-height:1.85; margin-bottom:16px;">The Green Rooms grew out of JPA Carpentry — a one-person operation James started building garden pergolas and custom furniture. As the requests shifted toward proper garden rooms, he recognised that most of what was on the market was underwhelming: timber frames that offered poor insulation, kit builds that needed a team of trades to finish, and companies that subcontracted the hard work to whoever was available.</p>
        <p style="font-size:1rem; color:#555; line-height:1.85; margin-bottom:16px;">In 2019, The Green Rooms was founded with a straightforward idea: build proper garden rooms, with proper materials, using our own carpenters — and hand everything over complete, the day we leave.</p>
        <p style="font-size:1rem; color:#555; line-height:1.85;">Since then, we've grown into a small but tightly run team of carpenters, installers, electricians and plasterers. We've built 150+ garden rooms across Surrey and the surrounding areas — and no two have been the same.</p>
      </div>
      <div style="background:#f8faf7; border-radius:20px; padding:40px; border:1px solid #ebeced;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
          {[
            { number: '2019', label: 'Founded' },
            { number: '150+', label: 'Garden Rooms Built' },
            { number: '5★', label: 'Google Rating' },
            { number: '2–3wk', label: 'Typical Build Time' },
          ].map(stat => (
            <div style="text-align:center; padding:20px 12px; background:#fff; border-radius:14px; border:1px solid #e7f1e3;">
              <p style="font-family:'Poppins',sans-serif; font-size:1.8rem; font-weight:700; color:#34a02e; margin:0 0 4px;">{stat.number}</p>
              <p style="font-size:13px; color:#555; font-weight:600; margin:0;">{stat.label}</p>
            </div>
          ))}
        </div>
        <div style="margin-top:24px; padding:20px; background:#fff; border-radius:14px; border:1px solid #e7f1e3;">
          <p style="font-size:13px; font-weight:700; color:#2d3841; margin:0 0 4px;">Based in Lyne, Surrey</p>
          <p style="font-size:13px; color:#666; margin:0;">Lyne Lane, Lyne, Surrey KT16 0AN</p>
          <p style="font-size:13px; color:#666; margin:4px 0 0;">Covering Surrey, Berkshire & West London</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section style="background:#2d3841; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:48px;">
        <div style="display:inline-block; background:rgba(52,160,46,0.15); color:#34a02e; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:5px 14px; border-radius:50px; margin-bottom:16px;">What We Stand For</div>
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#fff; margin:0;">How We Approach Every Build</h2>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
        {values.map(v => (
          <div style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:28px;">
            <div style="width:40px; height:40px; background:#34a02e; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:16px;">
              <Icon name={v.icon} size={20} color="#fff" />
            </div>
            <p style="font-size:14px; font-weight:700; color:#fff; margin:0 0 8px;">{v.title}</p>
            <p style="font-size:13px; color:rgba(255,255,255,0.6); line-height:1.7; margin:0;">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team -->
  <section style="background:#fff; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:40px;">
        <div style="display:inline-block; background:#e7f1e3; color:#257a21; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:5px 14px; border-radius:50px; margin-bottom:16px;">The Team</div>
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin:0;">The People Who Build Your Garden Room</h2>
      </div>
      <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:16px; margin-bottom:48px;">
        {team.map(member => (
          <div style="text-align:center; padding:24px 16px; background:#f8faf7; border-radius:16px; border:1px solid #ebeced;">
            {member.img
              ? <img src={member.img} alt={member.name} style={`width:120px; height:120px; border-radius:50%; object-fit:cover; object-position:${member.pos ?? 'center top'}; margin:0 auto 14px; display:block; border:3px solid #e7f1e3;`} loading="lazy" />
              : <div style="width:120px; height:120px; background:#e7f1e3; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 14px; font-size:36px; font-weight:700; color:#34a02e; font-family:'Poppins',sans-serif;">{member.name[0]}</div>
            }
            <p style="font-size:13px; font-weight:700; color:#2d3841; margin:0 0 4px;">{member.name}</p>
            <p style="font-size:12px; color:#666; margin:0;">{member.role}</p>
          </div>
        ))}
      </div>
      <div style="border-radius:20px; overflow:hidden; height:520px; background-image:url('/images/Green%20rooms%20team%20photo.jpg'); background-size:cover; background-position:center 55%;" role="img" aria-label="The Green Rooms team"></div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#fff; margin-bottom:14px;">Come and Meet Us</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px; line-height:1.7;">Visit our showroom at The Farm Shop, Lyne — you can walk around an actual finished garden room, touch the materials, and talk to the people who build them.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/showrooms" class="btn-white" style="font-size:15px; padding:14px 32px;">Visit Our Showroom</a>
        <a href="/contact-us" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

</InfoLayout>

<style>
  @media (max-width: 900px) {
    /* Collapse the story section outer grid (identified by its 72px gap) */
    div[style*="gap:72px"] { grid-template-columns: 1fr !important; gap: 40px !important; }
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
    div[style*="grid-template-columns:repeat(5,1fr)"] { grid-template-columns: repeat(3,1fr) !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
    div[style*="grid-template-columns:repeat(5,1fr)"] { grid-template-columns: 1fr 1fr !important; }
  }
</style>
