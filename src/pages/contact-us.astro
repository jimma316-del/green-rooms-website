---
import InfoLayout from '../layouts/InfoLayout.astro';
---

<InfoLayout
  title="Contact The Green Rooms | Free Site Visit | Garden Rooms Surrey"
  description="Get in touch with The Green Rooms. Book a free site visit, arrange a showroom appointment, or call us on 01932 640242. Based in Lyne, Surrey."
  canonical="/contact-us"
  pageTitle="Get in Touch"
  pageSubtitle="Book a free site visit, arrange a showroom appointment, or just give us a call. No obligation, no hard sell."
  heroImg="/images/showroom%20end%20of%20garden.jpg"
  heroAlt="The Green Rooms showroom, Lyne Surrey"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]}
>

  <section style="background:#fff; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:start;">

      <!-- Free site visit form -->
      <div>
        <div style="background:#2d3841; border-radius:20px; padding:36px;">
          <div style="display:inline-block; background:rgba(52,160,46,0.2); color:#34a02e; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:5px 14px; border-radius:50px; margin-bottom:16px;">Most Popular</div>
          <h2 style="font-size:1.4rem; font-weight:700; color:#fff; margin:0 0 8px;">Book a Free Site Visit</h2>
          <p style="font-size:13.5px; color:rgba(255,255,255,0.7); margin:0 0 28px; line-height:1.65;">We'll visit your garden, assess what's possible, and give you honest advice — with no obligation to proceed.</p>
          <form id="site-visit-form" name="site-visit" method="POST" style="display:flex; flex-direction:column; gap:14px;">
            <input type="hidden" name="form-name" value="site-visit" />
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div>
                <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">First Name *</label>
                <input type="text" name="first-name" required style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box;" class="form-input" placeholder="James" />
              </div>
              <div>
                <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">Surname *</label>
                <input type="text" name="surname" required style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box;" class="form-input" placeholder="Smith" />
              </div>
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">Phone Number *</label>
              <input type="tel" name="phone" required style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box;" class="form-input" placeholder="07700 000000" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">Email Address *</label>
              <input type="email" name="email" required style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box;" class="form-input" placeholder="james@example.com" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">Postcode *</label>
              <input type="text" name="postcode" required style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box;" class="form-input" placeholder="KT13 8AB" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">What type of garden room? *</label>
              <select name="room-type" required style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box; appearance:none;" class="form-input">
                <option value="" style="color:#333;">Select an option</option>
                <option value="pod" style="color:#333;">Garden Pod</option>
                <option value="office" style="color:#333;">Garden Office</option>
                <option value="garden-room" style="color:#333;">Garden Room</option>
                <option value="storage" style="color:#333;">Garden Room with Storage</option>
                <option value="golf" style="color:#333;">Golf Simulator Studio</option>
                <option value="bespoke" style="color:#333;">Bespoke / Not Sure</option>
              </select>
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:rgba(255,255,255,0.7); display:block; margin-bottom:5px;">How did you hear about us?</label>
              <select name="source" style="width:100%; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.15); border-radius:10px; padding:11px 14px; font-size:14px; color:#fff; outline:none; box-sizing:border-box; appearance:none;" class="form-input">
                <option value="" style="color:#333;">Select an option</option>
                <option value="google" style="color:#333;">Google</option>
                <option value="facebook" style="color:#333;">Facebook</option>
                <option value="instagram" style="color:#333;">Instagram</option>
                <option value="word-of-mouth" style="color:#333;">Word of mouth</option>
                <option value="other" style="color:#333;">Other</option>
              </select>
            </div>
            <button type="submit" id="site-visit-btn" class="btn-primary" style="font-size:15px; padding:14px; justify-content:center; margin-top:4px; width:100%;">Book My Free Site Visit</button>
            <p style="font-size:11px; color:rgba(255,255,255,0.45); text-align:center; margin:0;">We'll be in touch within 1 working day to arrange a convenient time.</p>
          </form>
          <div id="site-visit-success" style="display:none; padding:24px; text-align:center;">
            <div style="width:48px; height:48px; background:#34a02e; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 16px;"><svg width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
            <p style="font-size:1.1rem; font-weight:700; color:#fff; margin:0 0 8px;">Request Received</p>
            <p style="font-size:13.5px; color:rgba(255,255,255,0.7); margin:0; line-height:1.65;">We'll be in touch within one working day to arrange a convenient time for your free site visit.</p>
          </div>
        </div>
      </div>

      <!-- Showroom appointment + contact info -->
      <div style="display:flex; flex-direction:column; gap:28px;">

        <div style="background:#f8faf7; border-radius:20px; padding:32px; border:1px solid #ebeced;">
          <h2 style="font-size:1.3rem; font-weight:700; color:#2d3841; margin:0 0 8px;">Book a Showroom Appointment</h2>
          <p style="font-size:13.5px; color:#555; margin:0 0 24px; line-height:1.65;">Want someone from the team at our Lyne showroom to walk you through everything in person? Book an appointment below.</p>
          <form id="showroom-form" name="showroom-appointment" method="POST" style="display:flex; flex-direction:column; gap:12px;">
            <input type="hidden" name="form-name" value="showroom-appointment" />
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
              <div>
                <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">First Name *</label>
                <input type="text" name="first-name" required style="width:100%; background:#fff; border:1px solid #dce0dc; border-radius:10px; padding:10px 14px; font-size:14px; color:#2d3841; outline:none; box-sizing:border-box;" class="form-input-light" placeholder="James" />
              </div>
              <div>
                <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">Surname *</label>
                <input type="text" name="surname" required style="width:100%; background:#fff; border:1px solid #dce0dc; border-radius:10px; padding:10px 14px; font-size:14px; color:#2d3841; outline:none; box-sizing:border-box;" class="form-input-light" placeholder="Smith" />
              </div>
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">Contact Number *</label>
              <input type="tel" name="phone" required style="width:100%; background:#fff; border:1px solid #dce0dc; border-radius:10px; padding:10px 14px; font-size:14px; color:#2d3841; outline:none; box-sizing:border-box;" class="form-input-light" placeholder="07700 000000" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">Email Address *</label>
              <input type="email" name="email" required style="width:100%; background:#fff; border:1px solid #dce0dc; border-radius:10px; padding:10px 14px; font-size:14px; color:#2d3841; outline:none; box-sizing:border-box;" class="form-input-light" placeholder="james@example.com" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">Postcode</label>
              <input type="text" name="postcode" style="width:100%; background:#fff; border:1px solid #dce0dc; border-radius:10px; padding:10px 14px; font-size:14px; color:#2d3841; outline:none; box-sizing:border-box;" class="form-input-light" placeholder="KT13 8AB" />
            </div>
            <div>
              <label style="font-size:12px; font-weight:600; color:#555; display:block; margin-bottom:5px;">How did you hear about us?</label>
              <select name="source" style="width:100%; background:#fff; border:1px solid #dce0dc; border-radius:10px; padding:10px 14px; font-size:14px; color:#2d3841; outline:none; box-sizing:border-box; appearance:none;" class="form-input-light">
                <option value="">Select an option</option>
                <option value="google">Google</option>
                <option value="facebook">Facebook</option>
                <option value="instagram">Instagram</option>
                <option value="word-of-mouth">Word of mouth</option>
                <option value="other">Other</option>
              </select>
            </div>
            <button type="submit" id="showroom-btn" class="btn-primary" style="font-size:14px; padding:12px; justify-content:center; width:100%; margin-top:4px;">Book Showroom Appointment</button>
          </form>
          <div id="showroom-success" style="display:none; padding:20px; text-align:center;">
            <div style="width:48px; height:48px; background:#34a02e; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 14px;"><svg width="24" height="24" fill="none" stroke="#fff" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg></div>
            <p style="font-size:1rem; font-weight:700; color:#2d3841; margin:0 0 8px;">Appointment Request Received</p>
            <p style="font-size:13px; color:#555; margin:0; line-height:1.65;">We'll confirm a time with you within one working day.</p>
          </div>
        </div>

        <div style="background:#f8faf7; border-radius:20px; padding:28px; border:1px solid #ebeced;">
          <h3 style="font-size:1rem; font-weight:700; color:#2d3841; margin:0 0 16px;">Other Ways to Reach Us</h3>
          <div style="display:flex; flex-direction:column; gap:12px;">
            <a href="tel:01932640242" style="display:flex; align-items:center; gap:12px; text-decoration:none; padding:12px; background:#fff; border-radius:10px; border:1px solid #ebeced; transition:border-color 0.2s;" class="contact-link">
              <div style="width:36px; height:36px; background:#e7f1e3; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" fill="#34a02e" viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              </div>
              <div>
                <p style="font-size:12px; color:#666; margin:0 0 1px;">Phone</p>
                <p style="font-size:14px; font-weight:700; color:#2d3841; margin:0;">01932 640242</p>
              </div>
            </a>
            <a href="mailto:info@thegreenrooms.com" style="display:flex; align-items:center; gap:12px; text-decoration:none; padding:12px; background:#fff; border-radius:10px; border:1px solid #ebeced; transition:border-color 0.2s;" class="contact-link">
              <div style="width:36px; height:36px; background:#e7f1e3; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" fill="#34a02e" viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              </div>
              <div>
                <p style="font-size:12px; color:#666; margin:0 0 1px;">Email</p>
                <p style="font-size:14px; font-weight:700; color:#2d3841; margin:0;">info@thegreenrooms.com</p>
              </div>
            </a>
            <a href="https://wa.me/441932640242" target="_blank" rel="noopener" style="display:flex; align-items:center; gap:12px; text-decoration:none; padding:12px; background:#fff; border-radius:10px; border:1px solid #ebeced; transition:border-color 0.2s;" class="contact-link">
              <div style="width:36px; height:36px; background:#e7f1e3; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" fill="#34a02e" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              </div>
              <div>
                <p style="font-size:12px; color:#666; margin:0 0 1px;">WhatsApp</p>
                <p style="font-size:14px; font-weight:700; color:#2d3841; margin:0;">Message Us</p>
              </div>
            </a>
            <div style="display:flex; align-items:center; gap:12px; padding:12px; background:#fff; border-radius:10px; border:1px solid #ebeced;">
              <div style="width:36px; height:36px; background:#e7f1e3; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                <svg width="16" height="16" fill="#34a02e" viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              </div>
              <div>
                <p style="font-size:12px; color:#666; margin:0 0 1px;">Office</p>
                <p style="font-size:13px; font-weight:600; color:#2d3841; margin:0;">Lyne Lane, Lyne, Surrey KT16 0AN</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

</InfoLayout>

<script>
  function handleForm(formId: string, successId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const success = document.getElementById(successId);
    if (!form || !success) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
      fetch('/.netlify/functions/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString(),
      })
        .then(() => { form.style.display = 'none'; success.style.display = 'block'; })
        .catch(() => { form.style.display = 'none'; success.style.display = 'block'; });
    });
  }
  handleForm('site-visit-form', 'site-visit-success');
  handleForm('showroom-form', 'showroom-success');
</script>

<style>
  .form-input:focus { border-color: #34a02e !important; background: rgba(255,255,255,0.12) !important; }
  .form-input-light:focus { border-color: #34a02e !important; }
  .contact-link:hover { border-color: #34a02e !important; }
  @media (max-width: 900px) {
    div[style*="grid-template-columns:1fr 1fr"]:first-of-type { grid-template-columns: 1fr !important; gap: 28px !important; }
  }
</style>
