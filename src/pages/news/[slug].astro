---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.data.slug },
    props: { post, allPosts: posts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);
const formattedDate = new Date(post.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const siteUrl = 'https://www.thegreenrooms.com';

const relatedPosts = allPosts
  .filter(p => p.data.slug !== post.data.slug)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const postImage = post.data.image ?? '/images/Hero%20GR.webp';

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.excerpt,
  "image": `${siteUrl}${postImage}`,
  "datePublished": post.data.date,
  "dateModified": post.data.date,
  "author": {
    "@type": "Person",
    "name": "James",
    "jobTitle": "Owner & Principal Designer",
    "worksFor": { "@type": "Organization", "name": "The Green Rooms", "url": siteUrl }
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Green Rooms",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": "https://cdn.prod.website-files.com/65fa73870456aaad8a954b46/661cf61b0d2c970adddf26ad_the-green-rooms%20White.webp" }
  },
  "mainEntityOfPage": `${siteUrl}/news/${post.data.slug}`,
};
---

<Layout
  title={`${post.data.title} | The Green Rooms Surrey`}
  description={post.data.excerpt.slice(0, 155)}
  canonical={`/news/${post.data.slug}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <!-- Hero -->
  <div style="background:#2d3841; padding:56px 24px 48px;">
    <div style="max-width:860px; margin:0 auto;">
      <div style="display:flex; align-items:center; gap:8px; font-size:13px; margin-bottom:16px;">
        <a href="/" style="color:rgba(255,255,255,0.55); text-decoration:none;">Home</a>
        <span style="color:rgba(255,255,255,0.25);">›</span>
        <a href="/news" style="color:rgba(255,255,255,0.55); text-decoration:none;">News</a>
        <span style="color:rgba(255,255,255,0.25);">›</span>
        <span style="color:#34a02e; font-weight:600;">{post.data.title}</span>
      </div>
      <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(1.6rem,4vw,2.5rem); font-weight:700; color:#fff; margin:0 0 16px; line-height:1.2;">{post.data.title}</h1>
      <p style="color:rgba(255,255,255,0.6); font-size:13px; margin:0;">Published {formattedDate} · The Green Rooms, Surrey</p>
    </div>
  </div>

  <!-- Article body -->
  <section style="background:#fff; padding:72px 0;">
    <div style="max-width:860px; margin:0 auto; padding:0 24px;">
      <div class="prose">
        <Content />
      </div>

      <!-- CTA -->
      <div style="background:#f8faf7; border-radius:20px; padding:32px; text-align:center; margin-top:56px; border:1px solid #ebeced;">
        <h3 style="font-family:'Poppins',sans-serif; font-size:1.2rem; font-weight:700; color:#2d3841; margin:0 0 10px;">Thinking About a Garden Room?</h3>
        <p style="font-size:14px; color:#555; margin:0 0 20px; line-height:1.7;">Get an instant price estimate or book a free site visit with The Green Rooms team in Surrey.</p>
        <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
          <a href="/garden-room-price-calculator" class="btn-primary" style="font-size:14px; padding:12px 28px;">Get an Instant Quote</a>
          <a href="/contact-us" class="btn-secondary" style="font-size:14px; padding:12px 28px;">Book a Free Site Visit</a>
        </div>
      </div>

      <!-- Back link -->
      <div style="margin-top:40px;">
        <a href="/news" style="font-size:13px; color:#34a02e; font-weight:600; text-decoration:none;">← Back to all articles</a>
      </div>
    </div>
  </section>

  <!-- Related posts -->
  {relatedPosts.length > 0 && (
    <section style="background:#f8faf7; padding:72px 0; border-top:1px solid #ebeced;">
      <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
        <h2 style="font-family:'Poppins',sans-serif; font-size:1.35rem; font-weight:700; color:#2d3841; margin:0 0 28px;">More from The Green Rooms</h2>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
          {relatedPosts.map(p => (
            <a href={`/news/${p.data.slug}`} style="display:flex; flex-direction:column; text-decoration:none; background:#fff; border-radius:16px; padding:24px; border:1px solid #ebeced; transition:border-color 0.2s, box-shadow 0.2s;" class="related-card">
              <p style="font-size:11px; color:#34a02e; font-weight:700; text-transform:uppercase; letter-spacing:0.06em; margin:0 0 10px;">
                {new Date(p.data.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </p>
              <h3 style="font-family:'Poppins',sans-serif; font-size:15px; font-weight:700; color:#2d3841; margin:0 0 10px; line-height:1.35; flex:1;">{p.data.title}</h3>
              <p style="font-size:13px; color:#666; line-height:1.6; margin:0 0 16px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">{p.data.excerpt}</p>
              <span style="font-size:13px; font-weight:700; color:#34a02e;">Read more →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .prose {
    font-family: 'Inter', sans-serif;
    font-size: 15.5px;
    color: #444;
    line-height: 1.85;
  }
  .prose h2 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    color: #2d3841;
    margin: 2.5rem 0 1rem;
    line-height: 1.3;
  }
  .prose h3 {
    font-family: 'Poppins', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #2d3841;
    margin: 2rem 0 0.75rem;
  }
  .prose p { margin: 0 0 1.25rem; }
  .prose ul, .prose ol { padding-left: 1.5rem; margin: 0 0 1.25rem; }
  .prose li { margin-bottom: 0.5rem; }
  .prose a { color: #34a02e; font-weight: 600; }
  .prose a:hover { text-decoration: underline; }
  .prose strong { color: #2d3841; }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    font-family: 'Poppins', sans-serif;
    font-weight: 600;
    border-radius: 50px;
    text-decoration: none;
    border: 2px solid #2d3841;
    color: #2d3841;
    transition: background 0.2s, color 0.2s;
  }
  .btn-secondary:hover { background: #2d3841; color: #fff; }
  .related-card:hover { border-color: #34a02e !important; box-shadow: 0 4px 16px rgba(52,160,46,0.1); }

  @media (max-width: 768px) {
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
  }
</style>
