const categories = ['All', 'Garden Office', 'Garden Room', 'Garden Room with Storage', 'Garden Pod', 'Golf Simulator', 'Bespoke'];
---

<InfoLayout
  title="Our Work | Garden Room Portfolio Surrey | The Green Rooms"
  description="Browse The Green Rooms portfolio — completed garden offices, garden rooms, bespoke studios, golf simulator rooms and more, all built across Surrey and the South East."
  canonical="/our-work"
  pageTitle="Our Work"
  pageSubtitle="A selection of completed projects — every one built by our own team of carpenters, installed fully turnkey."
  heroImg="/images/HERO%20Bespoke%20build.webp"
  heroAlt="Completed garden room project by The Green Rooms, Surrey"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Our Work' }]}
>

  <!-- Filter -->
  <section style="background:#f8faf7; padding:24px; border-bottom:1px solid #ebeced;">
    <div style="max-width:1280px; margin:0 auto; display:flex; flex-wrap:wrap; gap:8px; justify-content:center;" id="filter-bar">
      {categories.map((cat, i) => (
        <button
          data-cat={cat}
          class={`filter-btn ${i === 0 ? 'active' : ''}`}
          style={`padding:8px 18px; border-radius:50px; border:1px solid ${i === 0 ? '#34a02e' : '#dce0dc'}; background:${i === 0 ? '#34a02e' : '#fff'}; color:${i === 0 ? '#fff' : '#2d3841'}; font-family:'Nunito',sans-serif; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s;`}
        >{cat}</button>
      ))}
    </div>
  </section>

  <!-- Grid -->
  <section style="background:#fff; padding:64px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;" id="projects-grid">
        {projects.map(p => (
          <div class="project-card" data-cat={p.category} style="border-radius:16px; overflow:hidden; border:1px solid #ebeced; display:flex; flex-direction:column;">
            <div style="position:relative; overflow:hidden; height:240px;">
              <img src={p.img} alt={p.title} style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s;" loading="lazy" class="project-img" />
              <div style="position:absolute; top:12px; left:12px;">
                <span style="background:#34a02e; color:#fff; font-size:11px; font-weight:700; padding:4px 12px; border-radius:50px;">{p.category}</span>
              </div>
            </div>
            <div style="padding:20px; flex:1; display:flex; flex-direction:column;">
              <h3 style="font-size:1rem; font-weight:700; color:#2d3841; margin:0 0 8px;">{p.title}</h3>
              <p style="font-size:13px; color:#555; line-height:1.65; margin:0; flex:1;">{p.desc}</p>
            </div>
          </div>
        ))}
      </div>
      <div id="no-results" style="display:none; text-align:center; padding:48px; color:#666; font-size:14px;">No projects found for this category.</div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-size:clamp(1.4rem,3vw,1.9rem); font-weight:700; color:#fff; margin-bottom:14px;">Want to See One In Person?</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px;">Visit our Lyne showroom and walk through a real finished garden room. Or book a free site visit — we'll come to you.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-white" style="font-size:15px; padding:14px 32px;">Get an Instant Quote</a>
        <a href="/contact-us" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

</InfoLayout>

<style>
  .project-card:hover .project-img { transform: scale(1.04); }
  .filter-btn.active { background: #34a02e !important; border-color: #34a02e !important; color: #fff !important; }
  .filter-btn:hover:not(.active) { border-color: #34a02e !important; color: #34a02e !important; }

  @media (max-width: 900px) {
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const noResults = document.getElementById('no-results')!;

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat!;
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      let visible = 0;
      cards.forEach(card => {
        const show = cat === 'All' || card.dataset.cat === cat;
        card.style.display = show ? 'flex' : 'none';
        if (show) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>
