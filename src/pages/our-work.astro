  },
  {
    title: 'Garden Gym with Hidden Storage — Chobham',
    category: 'Bespoke',
    desc: '5.8 × 5.3m gym built on a sloping strip of land in Chobham, Surrey. Western Red Cedar and metal box profile cladding, 3m black aluminium bifold doors, skylight, Wi-Fi-controlled air conditioning, and a hidden storage room accessed via a secret flush-clad door.',
    img: '/images/garden%20gym%2C%20dual%20canopy%20view%20from%20outside.webp',
  },
  {
    title: 'Thermo Ayous Garden Room with Decking',
    category: 'Garden Room',
    desc: 'Clean contemporary design with thermo ayous cladding and millboard decking. A popular low-maintenance finish.',
    img: '/images/GR%20extended%20height%20with%20thermo%20ayous%20cladding%20and%20millboard%20decking.webp',
  },
  {
    title: 'Virginia Water Garden Office',
    category: 'Garden Office',
    desc: 'Garden pod office with full electrics, Cat 6a internet and a dedicated workspace designed for daily remote working.',
    img: '/images/GP%20office%20internal.webp',
  },
  {
    title: 'Charred Spruce Garden Room — Night',
    category: 'Garden Room',
    desc: 'Charred spruce cladding with Crittall French doors, photographed at night showing the LED canopy and external lighting in full effect.',
