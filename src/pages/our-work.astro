---
import InfoLayout from '../layouts/InfoLayout.astro';

interface GalleryItem {
  title: string;
  category: string;
  spec: string;
  desc: string;
  img: string;
  slug?: string;
}

const projects: GalleryItem[] = [
  {
    title: 'Garden Gym with Hidden Storage — Chobham',
    slug: 'garden-gym-with-hidden-storage',
    category: 'Bespoke',
    spec: 'Western Red Cedar · Dual canopy · Glass corner · Dug down on slope · Chobham, Surrey',
    desc: 'Garden gym built on a sloping garden with the floor dug down for extra internal height. Cedar cladding, dual canopy, glass corner detail, 3m bifold doors, rooflight and concealed storage room at the rear.',
    img: '/images/garden%20gym%2C%20dual%20canopy%20view%20from%20outside.webp',
  },
  {
    title: 'Garden Room, Storage & Shelter — Godalming',
    slug: 'garden-entertainment-room-godalming',
    category: 'Bespoke',
    spec: 'Charred spruce & cedar · Mono-pitch · Bifolds & French doors · 80sqm porcelain · Godalming, Surrey',
    desc: 'Three-structure garden transformation: mono-pitch garden room with full-height front glazing, separate storage room, open shelter — all in charred spruce and cedar. 80sqm porcelain patio by our landscaping partner.',
    img: '/images/night%20time%20arty%20glossy%20bespoke%20build%20with%20separate%20storage%20room%20close%20up.webp',
  },
  {
    title: 'Garden Gym & Sauna — Surrey',
    slug: 'garden-gym-and-sauna',
    category: 'Bespoke',
    spec: 'Extended height 3m/2.5m · Thermo Ayous · Millboard Ebony Grey · Bike store · Surrey',
    desc: 'Extended height mono-pitch gym with Thermo Ayous cladding, large bifold doors, Millboard Ebony Grey Enhanced Grain decking, heavy duty rubber gym tile flooring, air conditioning and a bike store room.',
    img: '/images/GR%20extended%20height%20with%20thermo%20ayous%20cladding%20and%20millboard%20decking.webp',
  },
  {
    title: 'Golf Simulator Studio — Woking',
    slug: 'golf-simulator-woking',
    category: 'Golf Simulator',
    spec: 'Full planning permission · 3.7m height · Millboard board & batten · Foresight Sports · Woking, Surrey',
    desc: 'Golf simulator studio built to 3.7m requiring full planning permission. Millboard board and batten cladding, upholstered acoustic wall panels, Foresight Sports Europe GCHawk installation, synthetic turf hitting bay and lounge zone.',
    img: '/images/jc-golf-sim-night.webp',
  },
  {
    title: 'School Canteen Servery — All Hallows, Farnborough',
    slug: 'school-canteen-farnborough',
    category: 'Bespoke',
    spec: 'Siberian Larch · Red RAL roller shutter · Hygienic interior · Farnborough',
    desc: 'Commercial canteen servery for All Hallows school — Siberian Larch cladding to match an existing build, bespoke red RAL roller shutter, hygienic wall cladding interior. Completed within the Easter school holiday window.',
    img: '/images/all-hallows-canteen-1.webp',
  },
  {
    title: 'Bespoke Garden Room — Fliss & Luke, Weybridge',
    slug: 'bespoke-garden-room-weybridge-fliss',
    category: 'Bespoke',
    spec: '3m triple-pane sliding doors · Glass corner · Separate storage · Rear walkway · Weybridge, Surrey',
    desc: 'One of our most considered bespoke designs — 3m triple-pane sliding doors, glass corner detail, and a fully separate storage building maintaining walkway access to the rear garden. Completed 2021.',
    img: '/images/fliss-luke-bespoke-6.webp',
  },
  {
    title: 'Garden Office with Storage — Farnham',
    slug: 'garden-office-with-storage-farnham',
    category: 'Garden Office',
    spec: 'Western Red Cedar · Cedar soffit canopy · 3-panel bifolds · Grey composite decking · Farnham',
    desc: 'Cedar garden office with integrated storage room, deep cedar soffit canopy, 3-panel bifold doors and grey composite decking. Carpet flooring inside — Ollie\'s choice for a comfortable daily workspace.',
    img: '/images/ollie-garden-office-1.webp',
  },
  {
    title: 'Garden Office — Dan & Tamsin, Thorpe',
    slug: 'garden-office-thorpe-dan-tamsin',
    category: 'Garden Office',
    spec: 'Triple glazing · Hard-wired WiFi · Natural light positioning · Thorpe, Surrey',
    desc: 'Garden office for two professionals in Thorpe, Surrey. Triple glazing for acoustic performance, dedicated hard-wired WiFi access point, and deliberately positioned to track natural light through the working day.',
    img: '/images/dan-tamsin-office-hero.webp',
  },
  {
    title: 'Garden Office — Max, East Molesey',
    slug: 'garden-office-east-molesey-max',
    category: 'Garden Office',
    spec: 'Charred Spruce · 2.5m desk window · Boundary build · East Molesey, Surrey',
    desc: 'Two-person garden office replacing an old shed and fence — the boundary wall became the back wall of the building, maximising every centimetre. Charred spruce cladding, 2.5m full-height desk window facing the garden.',
    img: '/images/max-office-11.webp',
  },
  {
    title: 'Compact Garden Pod — Caroline',
    slug: 'compact-garden-pod-caroline',
    category: 'Garden Pod',
    spec: 'Hardie Plank Arctic White · UPVC sliding doors · 2.5×2.5m · No side access · Surrey',
    desc: 'Compact 2.5×2.5m office pod for one. Hardie Plank Arctic White cladding, UPVC sliding doors — every component carried through the house with no side garden access. Budget-conscious and brilliantly done.',
    img: '/images/caroline-pod-2.webp',
  },
];

const categories = ['All', 'Garden Office', 'Garden Pod', 'Golf Simulator', 'Bespoke'];
---

<InfoLayout
  title="Our Work | Garden Room Portfolio Surrey | The Green Rooms"
  description="Browse The Green Rooms portfolio — completed garden offices, garden rooms, bespoke studios, golf simulator rooms and more, all built across Surrey and the South East."
  canonical="/our-work"
  pageTitle="Our Work"
  pageSubtitle="We don't photograph every build, but here's a cross-section of recent projects. Every one designed, built and handed over by our own team."
  heroImg="/images/HERO%20Bespoke%20build.webp"
  heroAlt="Completed garden room project by The Green Rooms, Surrey"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Our Work' }]}
>

  <!-- Filter -->
  <section style="background:#f8faf7; padding:24px; border-bottom:1px solid #ebeced;">
    <div style="max-width:1280px; margin:0 auto; display:flex; flex-wrap:wrap; gap:8px; justify-content:center;" id="filter-bar">
      {categories.map((cat, i) => (
        <button
          data-cat={cat}
          class={`filter-btn ${i === 0 ? 'active' : ''}`}
          style={`padding:8px 18px; border-radius:50px; border:1px solid ${i === 0 ? '#34a02e' : '#dce0dc'}; background:${i === 0 ? '#34a02e' : '#fff'}; color:${i === 0 ? '#fff' : '#2d3841'}; font-family:'Nunito',sans-serif; font-size:13px; font-weight:600; cursor:pointer; transition:all 0.2s;`}
        >{cat}</button>
      ))}
    </div>
  </section>

  <!-- Grid -->
  <section style="background:#fff; padding:64px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;" id="projects-grid">
        {projects.map(p => (
          <div class={`project-card${p.slug ? ' linked-card' : ''}`} data-cat={p.category} style="position:relative; border-radius:16px; overflow:hidden; border:1px solid #ebeced; display:flex; flex-direction:column;">
            <div style="position:relative; overflow:hidden; height:240px;">
              <img src={p.img} alt={p.title} style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s;" loading="lazy" class="project-img" />
              <div style="position:absolute; top:12px; left:12px; display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                <span style="background:#34a02e; color:#fff; font-size:11px; font-weight:700; padding:4px 12px; border-radius:50px;">{p.category}</span>
                {p.slug && <span style="background:rgba(0,0,0,0.55); color:#fff; font-size:10px; font-weight:700; padding:4px 10px; border-radius:50px; letter-spacing:0.03em; backdrop-filter:blur(4px);">Full Project</span>}
              </div>
            </div>
            <div style="padding:20px; flex:1; display:flex; flex-direction:column;">
              <h3 style="font-size:1rem; font-weight:700; color:#2d3841; margin:0 0 5px;">{p.title}</h3>
              <p style="font-size:11px; color:#888; margin:0 0 9px; letter-spacing:0.01em; line-height:1.4;">{p.spec}</p>
              <p style="font-size:13px; color:#555; line-height:1.65; margin:0; flex:1;">{p.desc}</p>
              {p.slug && <p style="font-size:13px; font-weight:700; color:#34a02e; margin:12px 0 0; position:relative; z-index:1;">Read the full story →</p>}
            </div>
            {p.slug && <a href={`/our-work/${p.slug}`} aria-label={`View full project: ${p.title}`} style="position:absolute; inset:0;" />}
          </div>
        ))}
      </div>
      <div id="no-results" style="display:none; text-align:center; padding:48px; color:#666; font-size:14px;">No projects found for this category.</div>
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-size:clamp(1.4rem,3vw,1.9rem); font-weight:700; color:#fff; margin-bottom:14px;">Want to See One In Person?</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px;">Visit our Lyne showroom and walk through a real finished garden room. Or book a free site visit — we'll come to you.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-white" style="font-size:15px; padding:14px 32px;">Get an Instant Quote</a>
        <a href="/contact-us" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

</InfoLayout>

<style>
  .project-card:hover .project-img { transform: scale(1.04); }
  .linked-card { cursor: pointer; transition: border-color 0.2s, box-shadow 0.2s; }
  .linked-card:hover { border-color: #34a02e !important; box-shadow: 0 4px 20px rgba(52,160,46,0.12); }
  .filter-btn.active { background: #34a02e !important; border-color: #34a02e !important; color: #fff !important; }
  .filter-btn:hover:not(.active) { border-color: #34a02e !important; color: #34a02e !important; }

  @media (max-width: 900px) {
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const noResults = document.getElementById('no-results')!;

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat!;
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      let visible = 0;
      cards.forEach(card => {
        const show = cat === 'All' || card.dataset.cat === cat;
        card.style.display = show ? 'flex' : 'none';
        if (show) visible++;
      });
      noResults.style.display = visible === 0 ? 'block' : 'none';
    });
  });
</script>
