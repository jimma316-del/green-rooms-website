---
import InfoLayout from '../layouts/InfoLayout.astro';
import Icon from '../components/Icon.astro';

const reviews = [
  {
    name: 'Kate Hardesty',
    date: 'December 2025',
    text: `I would thoroughly recommend James and the team at The Green Rooms. We had a couple of other companies quote for our garden room but as soon as I met James I knew that he would do a great job. The whole process was so easy that I kept thinking something must go wrong. It didn't! James is really responsive and patient with any queries and the team are a credit to him. They are polite and tidy and produce an excellent finish. We absolutely love our garden room which we use as a cinema room and home office and cannot recommend The Green Rooms highly enough.\n\nA year later, I just need to say we still absolutely love our garden room and the after service we have received from James has been exceptional.`,
  },
  {
    name: 'James Ross',
    date: 'September 2025',
    text: `We are so happy with our new garden room. It's beautiful and divided perfectly between a home office and storage shed. Nothing else we looked at compared for price or quality so we're really pleased we went with The Green Rooms. Callum and Luke and the rest of the team were great to have around and did an excellent job. Everything was completed and signed off in good time and we can thoroughly recommend.`,
  },
  {
    name: 'Harvey Hood',
    date: 'May 2025',
    text: `We'd definitely recommend James and his exceptional team to anyone looking for a garden room/home office. James was very knowledgeable and consultative when we approached him and ensured the proposal maximised our budget. The team were a pleasure to have on site, they kept to the original timings, gave us regular updates, showed strong attention to detail and this shows in the quality of the finish. We are delighted with our new home office!`,
  },
  {
    name: 'Matt Grenyer',
    date: 'May 2025',
    text: `We'd thoroughly recommend James and his team to anyone looking at getting a garden office, and have sent their details to two friends who have wanted to explore getting their own office having seen ours.\n\nJames was incredibly helpful and patient as we explored various options to maximise our space within our price range, and we are thrilled with the result. Even down to a last minute window install during the build.\n\nWe've waited 6 months to write a review so we could honestly say that the installation during autumn and winter was brilliant. With the panel heater giving more than enough heat on the rare occasion it was needed. The guys on site were super courteous and did a great job, even making our toddler a mini ladder from off cuts of wood.\n\nThe office blends into the bottom of our garden as if it was always there.`,
  },
  {
    name: 'V Barman',
    date: 'August 2024',
    text: `I would really recommend The Green Rooms for anyone considering having a garden room installed in Surrey. We were quite nervous about such a big purchase and picked The Green Rooms after doing a lot of research and reading other positive reviews and this has really paid off. Our new garden office is beautiful, well made and is holding up well as a great working environment even during the hot summer days we've been having! Unlike other build projects, this didn't cause us any stress as James was so responsive the entire time both before, during and after the build if we had any questions, queries or tweaks. I would recommend James, Harry and the team to anyone considering having a garden office installed.`,
  },
];
---

<InfoLayout
  title="Customer Reviews | 5 Stars on Google | The Green Rooms Surrey"
  description="Read what our customers say about The Green Rooms — 5 stars on Google across 39 reviews. See verified reviews from homeowners across Surrey."
  canonical="/testimonials"
  pageTitle="What Our Customers Say"
  pageSubtitle="5 stars across 39 Google reviews. Here's what homeowners across Surrey say about their experience."
  heroImg="/images/classic%20end%20of%20garden%20portrait.jpg"
  heroAlt="Classic garden room end of garden, Surrey"
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Testimonials' }]}
>

  <!-- Google rating hero -->
  <section style="background:#e7f1e3; padding:48px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <div style="display:flex; justify-content:center; gap:6px; margin-bottom:12px;">
        {[1,2,3,4,5].map(() => (
          <svg width="32" height="32" fill="#f9bc02" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
        ))}
      </div>
      <p style="font-family:'Poppins',sans-serif; font-size:2.5rem; font-weight:700; color:#2d3841; margin:0 0 4px;">5.0</p>
      <p style="font-size:1rem; color:#555; margin:0;">Based on 39 Google Reviews</p>
    </div>
  </section>

  <!-- Google Reviews embed placeholder -->
  <section style="background:#fff; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:48px;">
        <h2 style="font-size:1.5rem; font-weight:700; color:#2d3841; margin:0 0 12px;">Verified Google Reviews</h2>
        <p style="font-size:14px; color:#555; max-width:480px; margin:0 auto;">All reviews below are verified Google reviews from real customers — we never edit, cherry-pick or manufacture testimonials.</p>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px; align-items:start;">
        {reviews.map(r => (
          <div style="background:#fff; border-radius:16px; padding:28px 28px 22px; border:1px solid #ebeced; display:flex; flex-direction:column;">
            <div style="display:flex; gap:3px; margin-bottom:14px;">
              {[1,2,3,4,5].map(() => (
                <svg width="16" height="16" fill="#f9bc02" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              ))}
            </div>
            <p style="font-size:13.5px; color:#444; line-height:1.85; margin:0 0 20px; white-space:pre-line; flex:1;">{r.text}</p>
            <div style="display:flex; align-items:center; justify-content:space-between; padding-top:16px; border-top:1px solid #f0f0f0;">
              <div>
                <p style="font-size:13px; font-weight:700; color:#2d3841; margin:0;">{r.name}</p>
                <p style="font-size:12px; color:#999; margin:2px 0 0;">{r.date}</p>
              </div>
              <div style="display:flex; align-items:center; gap:5px;">
                <svg width="16" height="16" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                <span style="font-size:11px; color:#999; font-weight:500;">Google</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      <div style="text-align:center; margin-top:32px;">
        <a href="https://g.page/r/CV8OY9TKZmc-EAE/review" target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:8px; font-family:'Poppins',sans-serif; font-size:13px; font-weight:600; color:#555; border:1px solid #ddd; padding:10px 20px; border-radius:50px; text-decoration:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          See all 39 reviews on Google
        </a>
      </div>
    </div>
  </section>

  <!-- Photo strip of completed builds -->
  <section style="background:#f8faf7; padding:72px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.3rem,2.5vw,1.7rem); font-weight:700; color:#2d3841; margin:0 0 24px;">Happy Customers, All Across Surrey</h2>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px; margin-bottom:12px;">
        <div style="border-radius:14px; overflow:hidden; height:260px;"><img src="/images/night%20lighting.jpg" alt="Garden room at night with LED canopy lighting" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:260px;"><img src="/images/GR%20dual%20canopy%20blinds%20glass%20corner.jpg" alt="Garden room with dual canopy and glass corner" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:260px;"><img src="/images/GR%20charred%20spruce%20in%20garden.jpg" alt="Garden room with charred spruce cladding" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr 1fr 1fr; gap:12px;">
        <div style="border-radius:14px; overflow:hidden; height:200px;"><img src="/images/classic%20GR%20no%20step%20cedar.jpg" alt="Classic cedar garden room" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:200px;"><img src="/images/GR%20side%20view%20in%20garden.jpeg" alt="Garden room side view in garden" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:200px;"><img src="/images/GR%20with%20cedar%20cladding%20Nordlux%20kyclop%20ripple%20wall%20light.jpg" alt="Cedar garden room with Nordlux wall light" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
        <div style="border-radius:14px; overflow:hidden; height:200px;"><img src="/images/winter%20shot%20of%20GR.jpg" alt="Garden room in winter" style="width:100%;height:100%;object-fit:cover;" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- Trust signals -->
  <section style="background:#2d3841; padding:64px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:repeat(3,1fr); gap:24px; text-align:center;">
      {[
        { icon: 'star',        stat: '5.0 / 5.0', label: 'Average Google Rating' },
        { icon: 'certificate', stat: '39',         label: 'Verified Google Reviews' },
        { icon: 'home',        stat: '150+',       label: 'Garden Rooms Built' },
      ].map(s => (
        <div style="padding:28px; border:1px solid rgba(255,255,255,0.08); border-radius:16px;">
          <div style="width:44px; height:44px; background:#34a02e; border-radius:12px; display:flex; align-items:center; justify-content:center; margin:0 auto 12px;">
            <Icon name={s.icon} size={22} color="#fff" />
          </div>
          <p style="font-family:'Poppins',sans-serif; font-size:2rem; font-weight:700; color:#34a02e; margin:0 0 6px;">{s.stat}</p>
          <p style="font-size:13px; color:rgba(255,255,255,0.6); margin:0;">{s.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-size:clamp(1.4rem,3vw,1.9rem); font-weight:700; color:#fff; margin-bottom:14px;">Become Our Next Happy Customer</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px;">Book a free site visit. We'll visit your garden, assess what's possible, and give you honest advice — with no obligation to proceed.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/contact-us" class="btn-white" style="font-size:15px; padding:14px 32px;">Book a Free Site Visit</a>
        <a href="/garden-room-price-calculator" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">Get an Instant Quote</a>
      </div>
    </div>
  </section>

</InfoLayout>

<style>
  @media (max-width: 900px) {
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr !important; }
  }
</style>
