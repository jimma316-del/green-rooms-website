---
import InfoLayout from '../../layouts/InfoLayout.astro';

export function getStaticPaths() {

  // Minimal preview data used to resolve related project cards
  const previews: Record<string, { h1: string; tagline: string; heroImg: string }> = {
    'garden-gym-with-hidden-storage':         { h1: 'Garden Gym with Hidden Storage',         tagline: 'Cedar cladding, dual canopy, glass corner — Chobham, Surrey',      heroImg: '/images/garden%20gym%2C%20dual%20canopy%20view%20from%20outside.webp' },
    'garden-entertainment-room-godalming':    { h1: 'Garden Room, Storage & Shelter',         tagline: 'Charred spruce and cedar, 80sqm porcelain patio — Godalming',      heroImg: '/images/GR%20at%20night%20charred%20spruce%20crittal%20french%20doors.webp' },
    'garden-gym-and-sauna':                   { h1: 'Garden Gym & Sauna',                     tagline: 'Extended height, Thermo Ayous, Millboard decking — Surrey',         heroImg: '/images/GR%20extended%20height%20with%20thermo%20ayous%20cladding%20and%20millboard%20decking.webp' },
  };

  const projects = {
    'garden-gym-with-hidden-storage': {
      title: 'Garden Gym with Hidden Storage — Chobham, Surrey',
      metaDesc: 'Bespoke garden gym built in Chobham, Surrey by The Green Rooms. Built on a slope with the ground dug down for extra internal height, cedar cladding, dual canopy, glass corner detail, 3m aluminium bifold doors, skylight and concealed storage room.',
      h1: 'Garden Gym with Hidden Storage',
      tagline: 'Cedar cladding, dual canopy and concealed storage — Chobham, Surrey',
      location: 'Chobham, Surrey',
      completedDate: 'Summer 2023',
      buildTime: '',
      challenge: "The garden sloped — and standard ground-level construction would have left the finished room with insufficient headroom for gym equipment and a full range of movement. The brief was: use the slope rather than fight it, and fit a hidden storage room in the same footprint.",
      intro: "This garden gym in Chobham is built on sloping ground, with the floor level dug down to gain additional internal height — enough for a full workout without compromise. At the rear, behind the gym space, a concealed storage room is accessed through a flush-clad door that disappears into the cedar exterior.",
      detail: "The exterior is Western Red Cedar with a dual canopy running the full width of the front elevation, creating a covered outdoor zone. The front elevation is glazed with 3m aluminium bifold doors and a signature glass corner detail — the glazing wraps around to the side wall, bringing light into the room from two directions. A rooflight overhead adds further daylight. Inside: light grey LVT flooring, white plastered walls ready to decorate, full electrical fit-out with recessed downlights, and a 5kW air conditioning unit. Composite decking outside the bifolds completes the space.",
      specs: [
        { label: 'Foundation', value: 'Dug down on slope for extra height', href: '/your-build/foundations' },
        { label: 'Cladding', value: 'Western Red Cedar', href: '/your-build/cladding-options' },
        { label: 'Canopy', value: 'Dual canopy — full width' },
        { label: 'Doors', value: '3m aluminium bifold doors', href: '/your-build/windows-and-doors' },
        { label: 'Glazing', value: 'Glass corner detail + rooflight', href: '/your-build/windows-and-doors' },
        { label: 'Flooring', value: 'Light grey LVT', href: '/your-build/flooring' },
        { label: 'Decking', value: 'Composite decking' },
        { label: 'Climate', value: '5kW air conditioning', href: '/your-build/climate-control' },
        { label: 'Storage', value: 'Concealed storage room at rear' },
      ],
      testimonial: {
        quote: "Incredible attention to detail, customer service, materials and quality of craftsmanship. Could not be happier with what James and his team built for us and perfectly on schedule too!",
        name: 'Nick',
        date: 'July 2023',
      },
      pricingNote: 'Garden gyms with integrated storage are priced individually based on size, slope complexity and specification. Contact us for a detailed quote after a free site visit.',
      ctaHeadline: 'Want a Garden Gym Built Around Your Space?',
      heroImg: '/images/garden%20gym%2C%20dual%20canopy%20view%20from%20outside.webp',
      gallery: [
        { src: '/images/GR%20glass%20corner%20dual%20canopy.webp', alt: 'Garden gym — glass corner detail and dual canopy viewed from outside' },
        { src: '/images/garden%20gym%20internal%201.webp', alt: 'Garden gym interior with light grey LVT flooring and bifold doors open' },
        { src: '/images/garden%20gym%20internal%202.webp', alt: 'Garden gym interior — full width view showing light and space' },
        { src: '/images/garden%20gym%20internal%203.webp', alt: 'Garden gym interior with recessed downlights and plastered walls' },
      ],
      related: '/garden-rooms/garden-gym',
      relatedLabel: 'Garden Gyms',
      relatedProjects: ['garden-entertainment-room-godalming', 'garden-gym-and-sauna'],
    },

    'garden-entertainment-room-godalming': {
      title: 'Garden Room, Storage & Shelter — Godalming, Surrey',
      metaDesc: 'Three-structure garden entertainment transformation in Godalming, Surrey by The Green Rooms. Pitched-roof garden room with glazed gable end, charred spruce and cedar cladding, bifold and French doors, separate storage room, open shelter and 80sqm porcelain patio.',
      h1: 'Garden Room, Storage & Shelter — Godalming',
      tagline: 'Charred spruce and cedar, pitched glazed gable, 80sqm porcelain patio',
      location: 'Godalming, Surrey',
      completedDate: 'Winter 2024',
      buildTime: '',
      challenge: "Chris and Claire wanted a complete garden transformation — not just a single room, but an entire outdoor entertainment zone. Three separate structures were needed: a main garden room, a storage room, and an open shelter. The challenge was designing everything as a coherent whole, not a collection of separate buildings.",
      intro: "This project is a complete garden entertainment transformation. We built three structures in one project: a pitched-roof garden room with a full-height glazed gable end, a separate storage room, and an open shelter — all in the same material palette. Our trusted landscaping partner simultaneously laid 80sqm of porcelain paving to tie the whole space together.",
      detail: "The garden room is clad in charred spruce with a signature pitched roof — the front gable is entirely glazed, floor to ceiling, flooding the interior with natural light. Aluminium bifold doors open to the front onto the porcelain patio; French doors at the rear open into a private outdoor entertaining space. The storage room uses cedar cladding and the open shelter combines both materials. Inside the garden room: plastered walls ready to decorate, LVT flooring, full electrical fit-out with recessed downlights and exterior soffit lighting. At night, the charred spruce, glazed gable and patio lighting make the space feel like a genuinely different place to be.",
      specs: [
        { label: 'Garden room roof', value: 'Pitched with full-height glazed gable end' },
        { label: 'Cladding', value: 'Charred spruce (garden room) + cedar (storage & shelter)', href: '/your-build/cladding-options' },
        { label: 'Front doors', value: 'Aluminium bifold doors', href: '/your-build/windows-and-doors' },
        { label: 'Rear doors', value: 'Aluminium French doors', href: '/your-build/windows-and-doors' },
        { label: 'Storage', value: 'Separate storage room — cedar clad' },
        { label: 'Shelter', value: 'Open shelter — cedar and charred spruce' },
        { label: 'Patio', value: '80sqm porcelain — via landscaping partner', href: '/your-build/landscaping' },
        { label: 'Flooring', value: 'LVT', href: '/your-build/flooring' },
        { label: 'Foundations', value: 'Ground screws', href: '/your-build/foundations' },
      ],
      testimonial: null,
      pricingNote: 'Multi-structure projects like this are individually designed and quoted. Landscaping is coordinated with our trusted partner. Contact us to discuss what you have in mind.',
      ctaHeadline: 'Thinking About a Full Garden Transformation?',
      heroImg: '/images/GR%20at%20night%20charred%20spruce%20crittal%20french%20doors.webp',
      gallery: [
        { src: '/images/GR%20charred%20spruce%20in%20garden.webp', alt: 'Charred spruce garden room in garden setting — Godalming, Surrey' },
        { src: '/images/bespoke%20shelter%20hot%20tub.webp', alt: 'Open shelter structure alongside garden room' },
        { src: '/images/GR%205m%20crittal%20bifolds.webp', alt: 'Bifold doors open onto porcelain patio — garden entertainment space' },
      ],
      related: '/garden-rooms/bespoke',
      relatedLabel: 'Bespoke Garden Rooms',
      relatedProjects: ['garden-gym-with-hidden-storage', 'garden-gym-and-sauna'],
    },

    'garden-gym-and-sauna': {
      title: 'Garden Gym & Sauna — Surrey',
      metaDesc: 'Extended height garden gym and sauna built in Surrey by The Green Rooms. 3m front height, Thermo Ayous cladding, large bifold doors, Millboard Ebony Grey Enhanced Grain decking, heavy duty rubber gym tile flooring, bike store, no planning permission required.',
      h1: 'Garden Gym & Sauna',
      tagline: 'Extended height, Thermo Ayous, Millboard Ebony Grey decking — Surrey',
      location: 'Surrey',
      completedDate: 'Winter 2024',
      buildTime: '',
      challenge: "Kate wanted a serious gym space with enough height to work out properly — and a sauna. The garden sits close to a boundary, which rules out extended height at the boundary line. The solution was to use a mono-pitch roof that gives full height at the front while keeping within Permitted Development at the rear.",
      intro: "This extended height gym is built to 3m at the front, tapering to 2.5m at the rear — a mono-pitch roof form that stays within Permitted Development by keeping the reduced height where it matters, within 2m of the boundary. No planning application required. The bike store room to the side adds practical storage without a separate structure.",
      detail: "The exterior is Thermo Ayous on the feature elevations — a heat-treated hardwood with a warm, close-grained finish — with metal cladding on the utility faces. Cedar soffit under the canopy adds warmth to the ceiling. The front elevation has large aluminium bifold doors opening fully onto Millboard Ebony Grey Enhanced Grain composite decking, with a fixed glazed panel alongside for additional light. Inside: heavy duty rubber gym tile flooring, plastered walls, full electrical fit-out with downlights and smart heating, and an air conditioning unit for year-round training comfort. The sauna was a client-supplied unit, installed into the space.",
      specs: [
        { label: 'Height', value: '3m (front) / 2.5m (rear) — mono-pitch', href: '/your-build/structure' },
        { label: 'Planning', value: 'No planning required — 2m from boundary' },
        { label: 'Cladding', value: 'Thermo Ayous + metal cladding', href: '/your-build/cladding-options' },
        { label: 'Soffit', value: 'Cedar soffit' },
        { label: 'Doors', value: 'Large aluminium bifold doors + fixed glazed panel', href: '/your-build/windows-and-doors' },
        { label: 'Side store', value: 'Bike store room' },
        { label: 'Decking', value: 'Millboard Ebony Grey Enhanced Grain', href: '/your-build/landscaping' },
        { label: 'Flooring', value: 'Heavy duty rubber gym tiles', href: '/your-build/flooring' },
        { label: 'Climate', value: 'Air conditioning', href: '/your-build/climate-control' },
        { label: 'Foundations', value: 'Ground screws', href: '/your-build/foundations' },
      ],
      testimonial: null,
      pricingNote: 'Extended height gym builds are priced individually. This type of project typically ranges from £35,000–£55,000 depending on size and internal fit-out. Contact us for a site visit and detailed quote.',
      ctaHeadline: 'Want a Serious Gym Space at the End of Your Garden?',
      heroImg: '/images/GR%20extended%20height%20with%20thermo%20ayous%20cladding%20and%20millboard%20decking.webp',
      gallery: [
        { src: '/images/classic%20GR%20front%20on%20thermo%20ayous%20cladding.webp', alt: 'Extended height garden room with Thermo Ayous cladding — front elevation' },
        { src: '/images/GR%20with%20storage%20with%204m%20sliding%20doors%20millboard%20cladding%20in%20ebony%20grey.webp', alt: 'Millboard Ebony Grey decking and cladding detail' },
        { src: '/images/garden%20gym%20internal%201.webp', alt: 'Garden gym interior — rubber tile flooring and bifold doors open' },
      ],
      related: '/garden-rooms/garden-gym',
      relatedLabel: 'Garden Gyms',
      relatedProjects: ['garden-gym-with-hidden-storage', 'garden-entertainment-room-godalming'],
    },
  };

  return Object.entries(projects).map(([slug, project]) => ({
    params: { slug },
    props: {
      data: {
        ...project,
        relatedProjectsData: project.relatedProjects.map(rSlug => ({
          slug: rSlug,
          ...previews[rSlug],
        })),
      },
    },
  }));
}

const { slug } = Astro.params;
const { data } = Astro.props;
const {
  title, metaDesc, h1, tagline, location, completedDate, buildTime,
  challenge, intro, detail, specs, testimonial, pricingNote, ctaHeadline,
  heroImg, gallery, related, relatedLabel, relatedProjectsData,
} = data;

// Filter hero image out of gallery to avoid showing it twice
const filteredGallery = gallery.filter((img: { src: string }) => img.src !== heroImg);

const siteUrl = 'https://www.thegreenrooms.com';

// Schema for the project page
const projectSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": h1,
  "description": metaDesc,
  "image": `${siteUrl}${heroImg}`,
  "author": {
    "@type": "Person",
    "name": "James",
    "jobTitle": "Owner & Principal Designer",
    "worksFor": { "@type": "Organization", "name": "The Green Rooms", "url": siteUrl }
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Green Rooms",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": "https://cdn.prod.website-files.com/65fa73870456aaad8a954b46/661cf61b0d2c970adddf26ad_the-green-rooms%20White.webp" }
  },
  "mainEntityOfPage": `${siteUrl}/our-work/${slug}`,
};

if (testimonial?.quote) {
  projectSchema["review"] = {
    "@type": "Review",
    "author": { "@type": "Person", "name": testimonial.name },
    "reviewBody": testimonial.quote,
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
  };
}
---

<InfoLayout
  title={`${title} | The Green Rooms Surrey`}
  description={metaDesc}
  canonical={`/our-work/${slug}`}
  pageTitle={h1}
  pageSubtitle={tagline}
  heroImg={heroImg}
  heroAlt={h1 + ' by The Green Rooms'}
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Our Work', href: '/our-work' }, { label: h1 }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />

  <!-- Project Story -->
  <section style="background:#fff; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:start;">

      <!-- Narrative -->
      <div>
        <div style="background:#f8faf7; border-left:3px solid #34a02e; padding:16px 20px; border-radius:0 10px 10px 0; margin-bottom:28px;">
          <p style="font-size:11px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 6px;">The Brief</p>
          <p style="font-size:14.5px; color:#2d3841; line-height:1.75; margin:0; font-weight:500;">{challenge}</p>
        </div>

        <p style="font-size:1rem; color:#555; line-height:1.85; margin:0 0 20px;">{intro}</p>
        <p style="font-size:1rem; color:#555; line-height:1.85; margin:0 0 32px;">{detail}</p>

        <!-- Project metadata strip -->
        {(() => {
          const meta = [
            { label: 'Location', value: location },
            { label: 'Completed', value: completedDate },
            { label: 'Build time', value: buildTime },
          ].filter(m => m.value);
          return meta.length > 0 && (
            <div style="display:flex; flex-wrap:wrap; gap:0; margin-bottom:32px; border:1px solid #ebeced; border-radius:12px; overflow:hidden;">
              {meta.map((m, i) => (
                <div style={`flex:1; min-width:120px; padding:14px 16px; text-align:center; ${i < meta.length - 1 ? 'border-right:1px solid #ebeced;' : ''}`}>
                  <p style="font-size:10px; font-weight:700; color:#aaa; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 3px;">{m.label}</p>
                  <p style="font-size:13.5px; font-weight:700; color:#2d3841; margin:0;">{m.value}</p>
                </div>
              ))}
            </div>
          );
        })()}

        <a href="/contact-us" class="btn-primary">Book a Free Site Visit</a>
      </div>

      <!-- Spec table -->
      <div>
        <div style="background:#f8faf7; border-radius:16px; padding:28px; border:1px solid #ebeced;">
          <p style="font-size:12px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 16px;">Project Specification</p>
          <table style="width:100%; border-collapse:collapse;">
            {specs.map((s: { label: string; value: string; href?: string }) => (
              <tr style="border-bottom:1px solid #ebeced;">
                <td style="font-size:13px; font-weight:600; color:#2d3841; padding:11px 0; width:42%; vertical-align:top;">{s.label}</td>
                <td style="font-size:13px; color:#555; padding:11px 0;">
                  {s.href
                    ? <a href={s.href} style="color:#34a02e; font-weight:600; text-decoration:none;">{s.value} →</a>
                    : s.value
                  }
                </td>
              </tr>
            ))}
          </table>
          <div style="margin-top:16px; padding-top:16px; border-top:1px solid #ebeced;">
            <p style="font-size:12px; color:#888; margin:0; line-height:1.6;">→ marked items link to our <a href="/your-build" style="color:#34a02e; font-weight:600;">Your Build guide</a> for more detail on each element.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {filteredGallery.length > 0 && (
    <section style="background:#f8faf7; padding:72px 0;">
      <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
        <h2 style="font-size:clamp(1.3rem,2.5vw,1.7rem); font-weight:700; color:#2d3841; margin:0 0 28px;">{h1} — Project Photos</h2>
        <div style={`display:grid; grid-template-columns:${filteredGallery.length >= 3 ? 'repeat(3,1fr)' : filteredGallery.length === 2 ? '1fr 1fr' : '1fr'}; gap:12px;`}>
          {filteredGallery.map((img: { src: string; alt: string }) => (
            <div style="border-radius:12px; overflow:hidden; aspect-ratio:4/3;">
              <img src={img.src} alt={img.alt} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Client testimonial -->
  {testimonial && (
    <section style="background:#fff; padding:72px 0; border-top:1px solid #ebeced;">
      <div style="max-width:760px; margin:0 auto; padding:0 24px; text-align:center;">
        <div style="display:flex; justify-content:center; gap:3px; margin-bottom:16px;">
          {[1,2,3,4,5].map(() => <svg width="18" height="18" fill="#f59e0b" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}
        </div>
        <blockquote style="margin:0 0 16px;">
          <p style="font-size:1.05rem; color:#444; line-height:1.85; margin:0; font-style:italic;">"{testimonial.quote}"</p>
        </blockquote>
        <p style="font-size:13px; font-weight:700; color:#2d3841; margin:0;">{testimonial.name} <span style="font-weight:400; color:#888;">· {testimonial.date}</span></p>
        <p style="margin:16px 0 0;"><a href="/testimonials" style="font-size:13px; color:#34a02e; font-weight:600; text-decoration:none;">Read all 39 Google reviews →</a></p>
      </div>
    </section>
  )}

  <!-- Pricing callout -->
  <section style="background:#f8faf7; padding:64px 0; border-top:1px solid #ebeced;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;">
      <div>
        <p style="font-size:12px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 10px;">Pricing</p>
        <h3 style="font-size:clamp(1.2rem,2vw,1.5rem); font-weight:700; color:#2d3841; margin:0 0 12px;">What Would This Cost?</h3>
        <p style="font-size:14.5px; color:#555; line-height:1.8; margin:0;">{pricingNote}</p>
      </div>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-primary" style="text-align:center; justify-content:center;">Get an Instant Price Estimate</a>
        <a href="/our-prices" style="display:flex; align-items:center; justify-content:center; border:2px solid #2d3841; color:#2d3841; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:11px 24px; border-radius:50px; text-decoration:none; transition:all 0.2s;" class="btn-outline-dk">See Full Price Guide →</a>
      </div>
    </div>
  </section>

  <!-- Related projects -->
  {relatedProjectsData.length > 0 && (
    <section style="background:#fff; padding:72px 0; border-top:1px solid #ebeced;">
      <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
        <h2 style="font-size:clamp(1.3rem,2.5vw,1.7rem); font-weight:700; color:#2d3841; margin:0 0 28px;">More Projects</h2>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
          {relatedProjectsData.map((rp: { slug: string; h1: string; tagline: string; heroImg: string }) => (
            <a href={`/our-work/${rp.slug}`} style="display:flex; flex-direction:column; text-decoration:none; border-radius:16px; overflow:hidden; border:1px solid #ebeced; transition:border-color 0.2s, box-shadow 0.2s;" class="project-card">
              <div style="height:200px; overflow:hidden;">
                <img src={rp.heroImg} alt={rp.h1 + ' by The Green Rooms'} style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s;" class="proj-img" loading="lazy" />
              </div>
              <div style="padding:20px;">
                <p style="font-size:15px; font-weight:700; color:#2d3841; margin:0 0 5px; font-family:'Poppins',sans-serif;">{rp.h1}</p>
                <p style="font-size:13px; color:#666; margin:0 0 10px; line-height:1.5;">{rp.tagline}</p>
                <span style="font-size:13px; font-weight:700; color:#34a02e;">View project →</span>
              </div>
            </a>
          ))}
        </div>
        <p style="text-align:center; margin:24px 0 0;"><a href="/our-work" style="font-size:13.5px; color:#34a02e; font-weight:600; text-decoration:none;">See all projects →</a></p>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.4rem,3vw,2rem); font-weight:700; color:#fff; margin:0 0 14px;">{ctaHeadline}</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin:0 0 28px; line-height:1.8;">Book a free, no-obligation site visit. We come to you, assess the space, and give you an honest quote — no pressure.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/contact-us" class="btn-white" style="font-size:15px; padding:14px 32px;">Book a Free Site Visit</a>
        <a href={related} style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.4); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">{relatedLabel} →</a>
      </div>
    </div>
  </section>

</InfoLayout>

<style>
  .btn-outline-dk:hover { background: #2d3841 !important; color: #fff !important; }
  .project-card:hover { border-color: #34a02e !important; box-shadow: 0 4px 20px rgba(52,160,46,0.12); }
  .project-card:hover .proj-img { transform: scale(1.04); }

  @media (max-width: 900px) {
    div[style*="grid-template-columns:1fr 1fr"]:not([style*="repeat"]) { grid-template-columns: 1fr !important; gap: 40px !important; }
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
