      detail: "LED strip lighting runs around the full ceiling perimeter, with external up/down wall lights on the back wall for evening use. The floor is composite decking laid flush with the surrounding garden level, making the structure feel like part of the garden rather than an addition to it. A dedicated electrical supply powers the hot tub, the lighting circuits, and an outdoor speaker system. The whole structure sits on ground screws — no concrete, no mess, and fully reversible if requirements change.",
      specs: [
        { label: 'Structure', value: 'Open-sided garden shelter' },
        { label: 'Cladding', value: 'Thermo Ayous back wall', href: '/your-build/cladding-options' },
        { label: 'Flooring', value: 'Composite decking', href: '/your-build/landscaping' },
        { label: 'Lighting', value: 'LED strip + up/down wall lights', href: '/your-build/electrics' },
        { label: 'Electrics', value: 'Hot tub supply + outdoor circuits', href: '/your-build/electrics' },
        { label: 'Foundations', value: 'Ground screws', href: '/your-build/foundations' },
      ],
      testimonial: {
        quote: "James and his team did an excellent job — they listened to what we needed and delivered on time, on budget and in an extremely professional way. I cannot recommend them enough.",
        name: 'Ian Evans',
        date: 'June 2025',
      },
      pricingNote: "Bespoke outdoor shelters and open structures are priced individually — most start from £12,000–£18,000 depending on size and specification. Contact us to discuss your project.",
      ctaHeadline: 'Want a Year-Round Outdoor Entertaining Space?',
      heroImg: '/images/bespoke%20shelter%20hot%20tub.webp',
      gallery: [
        { src: '/images/bespoke%20shelter%20square%20on.webp', alt: 'Garden shelter square-on view — open-sided structure with back wall' },
        { src: '/images/bespoke%20shelter.webp', alt: 'Bespoke garden shelter exterior — Thermo Ayous cladding' },
        { src: '/images/GR%20decking.webp', alt: 'Composite decking inside outdoor living space' },
      ],
      related: '/garden-rooms/bespoke',
      relatedLabel: 'Bespoke Garden Rooms',
      relatedProjects: ['garden-room-with-decking-lean-to-shed', 'oak-garden-room'],
    },

    'garden-hobby-room': {
      title: 'Garden Hobby Room — Surrey',
      metaDesc: 'Bespoke garden hobby room built in Surrey by The Green Rooms. Thermo Ayous cladding, aluminium sliding doors, LVT flooring, plastered walls, full electrics — a dedicated personal space separate from the house.',
      h1: 'Garden Hobby Room',
      tagline: 'A dedicated personal space — Thermo Ayous, LVT flooring — Surrey',
      location: 'Surrey',
      completedDate: 'Winter 2022',
      buildTime: '9 days',
      challenge: "The client wanted somewhere separate from the house to pursue crafts and creative projects — without the cost and complexity of a bespoke build. The brief was simple: a comfortable, well-lit, warm room that felt like a proper space, not a shed.",
      intro: "This garden hobby room is a straightforward build executed well. Thermo Ayous cladding, a sliding door, and a large fixed window provide a clean exterior. The quality is in what you don't see: SIPs insulation, a properly tested electrical installation, and a finish level that makes it feel like a room in the house.",
      detail: "Inside: plastered and painted walls, LVT flooring, multiple double sockets, USB outlets, overhead LED lighting on a dimmer, and a wall-mounted electric panel heater. No air conditioning — the SIPs insulation keeps the room comfortable without it for nine months of the year. The client uses this room every single day.",
      specs: [
        { label: 'Structure', value: 'Standard height flat roof', href: '/your-build/structure' },
        { label: 'Cladding', value: 'Thermo Ayous', href: '/your-build/cladding-options' },
        { label: 'Doors', value: 'Aluminium sliding doors', href: '/your-build/windows-and-doors' },
        { label: 'Flooring', value: 'LVT', href: '/your-build/flooring' },
        { label: 'Finish', value: 'Plastered and painted', href: '/your-build/decorating' },
        { label: 'Climate', value: 'Electric panel heater', href: '/your-build/climate-control' },
        { label: 'Foundations', value: 'Ground screws', href: '/your-build/foundations' },
      ],
      testimonial: {
        quote: "The garden room was exceptional during the hot summer months — it remained cool and comfortable without any air conditioning, which was a pleasant surprise. James is a true professional and craftsman.",
        name: 'V Barman',
        date: 'June 2023',
      },
      pricingNote: "Garden hobby rooms and standard garden rooms start from £15,000 depending on size. Use our price calculator to configure your build and get an instant guide price.",
      ctaHeadline: 'Want a Dedicated Space of Your Own?',
      heroImg: '/images/bespoke%20shape%20GP.webp',
      gallery: [
        { src: '/images/internal%20room.webp', alt: 'Garden hobby room interior — plastered walls, LVT flooring' },
        { src: '/images/bespoke%20shape%20window.webp', alt: 'Garden hobby room window detail — natural light' },
        { src: '/images/classic%20GR%20no%20step%20front%20on.webp', alt: 'Garden hobby room exterior front-on view' },
      ],
      related: '/garden-rooms/garden-rooms',
      relatedLabel: 'Garden Rooms',
      relatedProjects: ['oak-garden-room', 'outdoor-living-space'],
    },
  };

  return Object.entries(projects).map(([slug, project]) => ({
    params: { slug },
    props: {
      data: {
        ...project,
        relatedProjectsData: project.relatedProjects.map(rSlug => ({
          slug: rSlug,
          ...previews[rSlug],
        })),
      },
    },
  }));
}

const { slug } = Astro.params;
const { data } = Astro.props;
const {
  title, metaDesc, h1, tagline, location, completedDate, buildTime,
  challenge, intro, detail, specs, testimonial, pricingNote, ctaHeadline,
  heroImg, gallery, related, relatedLabel, relatedProjectsData,
} = data;

// Filter hero image out of gallery to avoid showing it twice
const filteredGallery = gallery.filter((img: { src: string }) => img.src !== heroImg);

const siteUrl = 'https://www.thegreenrooms.com';

// Schema for the project page
const projectSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": h1,
  "description": metaDesc,
  "image": `${siteUrl}${heroImg}`,
  "author": {
    "@type": "Person",
    "name": "James",
    "jobTitle": "Owner & Principal Designer",
    "worksFor": { "@type": "Organization", "name": "The Green Rooms", "url": siteUrl }
  },
  "publisher": {
    "@type": "Organization",
    "name": "The Green Rooms",
    "url": siteUrl,
    "logo": { "@type": "ImageObject", "url": "https://cdn.prod.website-files.com/65fa73870456aaad8a954b46/661cf61b0d2c970adddf26ad_the-green-rooms%20White.webp" }
  },
  "mainEntityOfPage": `${siteUrl}/our-work/${slug}`,
};

if (testimonial?.quote) {
  projectSchema["review"] = {
    "@type": "Review",
    "author": { "@type": "Person", "name": testimonial.name },
    "reviewBody": testimonial.quote,
    "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" }
  };
}
---

<InfoLayout
  title={`${title} | The Green Rooms Surrey`}
  description={metaDesc}
  canonical={`/our-work/${slug}`}
  pageTitle={h1}
  pageSubtitle={tagline}
  heroImg={heroImg}
  heroAlt={h1 + ' by The Green Rooms'}
  breadcrumb={[{ label: 'Home', href: '/' }, { label: 'Our Work', href: '/our-work' }, { label: h1 }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />

  <!-- Project Story -->
  <section style="background:#fff; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1fr 1fr; gap:72px; align-items:start;">

      <!-- Narrative -->
      <div>
        <div style="background:#f8faf7; border-left:3px solid #34a02e; padding:16px 20px; border-radius:0 10px 10px 0; margin-bottom:28px;">
          <p style="font-size:11px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 6px;">The Brief</p>
          <p style="font-size:14.5px; color:#2d3841; line-height:1.75; margin:0; font-weight:500;">{challenge}</p>
        </div>

        <p style="font-size:1rem; color:#555; line-height:1.85; margin:0 0 20px;">{intro}</p>
        <p style="font-size:1rem; color:#555; line-height:1.85; margin:0 0 32px;">{detail}</p>

        <!-- Project metadata strip -->
        <div style="display:flex; flex-wrap:wrap; gap:0; margin-bottom:32px; border:1px solid #ebeced; border-radius:12px; overflow:hidden;">
          {[
            { label: 'Location', value: location },
            { label: 'Completed', value: completedDate },
            { label: 'Build time', value: buildTime },
          ].map((m, i) => (
            <div style={`flex:1; min-width:120px; padding:14px 16px; text-align:center; ${i < 2 ? 'border-right:1px solid #ebeced;' : ''}`}>
              <p style="font-size:10px; font-weight:700; color:#aaa; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 3px;">{m.label}</p>
              <p style="font-size:13.5px; font-weight:700; color:#2d3841; margin:0;">{m.value}</p>
            </div>
          ))}
        </div>

        <a href="/contact-us" class="btn-primary">Book a Free Site Visit</a>
      </div>

      <!-- Spec table -->
      <div>
        <div style="background:#f8faf7; border-radius:16px; padding:28px; border:1px solid #ebeced;">
          <p style="font-size:12px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 16px;">Project Specification</p>
          <table style="width:100%; border-collapse:collapse;">
            {specs.map((s: { label: string; value: string; href?: string }) => (
              <tr style="border-bottom:1px solid #ebeced;">
                <td style="font-size:13px; font-weight:600; color:#2d3841; padding:11px 0; width:42%; vertical-align:top;">{s.label}</td>
                <td style="font-size:13px; color:#555; padding:11px 0;">
                  {s.href
                    ? <a href={s.href} style="color:#34a02e; font-weight:600; text-decoration:none;">{s.value} →</a>
                    : s.value
                  }
                </td>
              </tr>
            ))}
          </table>
          <div style="margin-top:16px; padding-top:16px; border-top:1px solid #ebeced;">
            <p style="font-size:12px; color:#888; margin:0; line-height:1.6;">→ marked items link to our <a href="/your-build" style="color:#34a02e; font-weight:600;">Your Build guide</a> for more detail on each element.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Gallery -->
  {filteredGallery.length > 0 && (
    <section style="background:#f8faf7; padding:72px 0;">
      <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
        <h2 style="font-size:clamp(1.3rem,2.5vw,1.7rem); font-weight:700; color:#2d3841; margin:0 0 28px;">{h1} — Project Photos</h2>
        <div style={`display:grid; grid-template-columns:${filteredGallery.length >= 3 ? 'repeat(3,1fr)' : filteredGallery.length === 2 ? '1fr 1fr' : '1fr'}; gap:12px;`}>
          {filteredGallery.map((img: { src: string; alt: string }) => (
            <div style="border-radius:12px; overflow:hidden; aspect-ratio:4/3;">
              <img src={img.src} alt={img.alt} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Client testimonial -->
  <section style="background:#fff; padding:72px 0; border-top:1px solid #ebeced;">
    <div style="max-width:760px; margin:0 auto; padding:0 24px; text-align:center;">
      <div style="display:flex; justify-content:center; gap:3px; margin-bottom:16px;">
        {[1,2,3,4,5].map(() => <svg width="18" height="18" fill="#f59e0b" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>)}
      </div>
      <blockquote style="margin:0 0 16px;">
        <p style="font-size:1.05rem; color:#444; line-height:1.85; margin:0; font-style:italic;">"{testimonial.quote}"</p>
      </blockquote>
      <p style="font-size:13px; font-weight:700; color:#2d3841; margin:0;">{testimonial.name} <span style="font-weight:400; color:#888;">· {testimonial.date}</span></p>
      <p style="margin:16px 0 0;"><a href="/testimonials" style="font-size:13px; color:#34a02e; font-weight:600; text-decoration:none;">Read all 39 Google reviews →</a></p>
    </div>
  </section>

  <!-- Pricing callout -->
  <section style="background:#f8faf7; padding:64px 0; border-top:1px solid #ebeced;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1fr 1fr; gap:48px; align-items:center;">
      <div>
        <p style="font-size:12px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin:0 0 10px;">Pricing</p>
        <h3 style="font-size:clamp(1.2rem,2vw,1.5rem); font-weight:700; color:#2d3841; margin:0 0 12px;">What Would This Cost?</h3>
        <p style="font-size:14.5px; color:#555; line-height:1.8; margin:0;">{pricingNote}</p>
      </div>
      <div style="display:flex; flex-direction:column; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-primary" style="text-align:center; justify-content:center;">Get an Instant Price Estimate</a>
        <a href="/our-prices" style="display:flex; align-items:center; justify-content:center; border:2px solid #2d3841; color:#2d3841; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:11px 24px; border-radius:50px; text-decoration:none; transition:all 0.2s;" class="btn-outline-dk">See Full Price Guide →</a>
      </div>
    </div>
  </section>

  <!-- Related projects -->
  {relatedProjectsData.length > 0 && (
    <section style="background:#fff; padding:72px 0; border-top:1px solid #ebeced;">
      <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
        <h2 style="font-size:clamp(1.3rem,2.5vw,1.7rem); font-weight:700; color:#2d3841; margin:0 0 28px;">More Projects</h2>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:20px;">
          {relatedProjectsData.map((rp: { slug: string; h1: string; tagline: string; heroImg: string }) => (
            <a href={`/our-work/${rp.slug}`} style="display:flex; flex-direction:column; text-decoration:none; border-radius:16px; overflow:hidden; border:1px solid #ebeced; transition:border-color 0.2s, box-shadow 0.2s;" class="project-card">
              <div style="height:200px; overflow:hidden;">
                <img src={rp.heroImg} alt={rp.h1 + ' by The Green Rooms'} style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s;" class="proj-img" loading="lazy" />
              </div>
              <div style="padding:20px;">
                <p style="font-size:15px; font-weight:700; color:#2d3841; margin:0 0 5px; font-family:'Poppins',sans-serif;">{rp.h1}</p>
                <p style="font-size:13px; color:#666; margin:0 0 10px; line-height:1.5;">{rp.tagline}</p>
                <span style="font-size:13px; font-weight:700; color:#34a02e;">View project →</span>
              </div>
            </a>
          ))}
        </div>
        <p style="text-align:center; margin:24px 0 0;"><a href="/our-work" style="font-size:13.5px; color:#34a02e; font-weight:600; text-decoration:none;">See all projects →</a></p>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:520px; margin:0 auto;">
      <h2 style="font-family:'Poppins',sans-serif; font-size:clamp(1.4rem,3vw,2rem); font-weight:700; color:#fff; margin:0 0 14px;">{ctaHeadline}</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin:0 0 28px; line-height:1.8;">Book a free, no-obligation site visit. We come to you, assess the space, and give you an honest quote — no pressure.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/contact-us" class="btn-white" style="font-size:15px; padding:14px 32px;">Book a Free Site Visit</a>
        <a href={related} style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.4); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none;">{relatedLabel} →</a>
      </div>
    </div>
  </section>

</InfoLayout>

<style>
  .btn-outline-dk:hover { background: #2d3841 !important; color: #fff !important; }
  .project-card:hover { border-color: #34a02e !important; box-shadow: 0 4px 20px rgba(52,160,46,0.12); }
  .project-card:hover .proj-img { transform: scale(1.04); }

  @media (max-width: 900px) {
    div[style*="grid-template-columns:1fr 1fr"]:not([style*="repeat"]) { grid-template-columns: 1fr !important; gap: 40px !important; }
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
