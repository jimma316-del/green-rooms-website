      pricingNote: 'Garden gyms with integrated storage are priced individually based on size, slope complexity and specification. Contact us for a detailed quote after a free site visit.',
      ctaHeadline: 'Want a Garden Gym Built Around Your Space?',
      heroImg: '/images/garden%20gym%2C%20dual%20canopy%20view%20from%20outside.webp',
      gallery: [
