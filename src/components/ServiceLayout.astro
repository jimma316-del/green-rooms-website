---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  heroImg: string;
  heroSrcset?: string;
  heroAlt: string;
  h1: string;
  tagline: string;
  intro: string;
  price?: string;
  features: { icon: string; title: string; desc: string }[];
  relatedPages?: { label: string; href: string; img: string }[];
}

const {
  title, description, canonical,
  heroImg, heroSrcset: heroSrcsetProp, heroAlt, h1, tagline, intro, price,
  features, relatedPages = [],
} = Astro.props;

function smSrcset(img: string, existing?: string) {
  if (existing) return existing;
  const filename = img.split('/').pop()!;
  const decoded = decodeURIComponent(filename);
  const dot = decoded.lastIndexOf('.');
  const base = decoded.substring(0, dot);
  const sm = '/images/sm/' + encodeURIComponent(base + '-sm.jpg');
  return `${sm} 900w, ${img} 1920w`;
}
const heroSrcset = smSrcset(heroImg, heroSrcsetProp);

const whyUs = [
  { title: 'SIPs Construction', desc: 'Structural Insulated Panels — far superior insulation, strength and soundproofing compared to timber frame. Warm in winter, cool in summer.' },
  { title: '30+ Year Cladding', desc: 'Thermo Ayous, Cedar, Charred Spruce, Hardie Plank, Millboard or Thermo Ash. Every material chosen for longevity. No Redwood, ever.' },
  { title: '20-Year Roof Guarantee', desc: 'EPDM or metal panel on every build — never felt. Both carry a 20-year guarantee as standard.' },
  { title: 'Fully Turnkey Service', desc: 'Foundations, structure, cladding, glazing, electrics, flooring, plastering, and site clean-up all included. We hand the keys over on the last day — you walk into a finished room.' },
  { title: 'Electrical Sign-Off', desc: 'Mains-connected consumer unit, full testing, and a signed electrical certificate included on every single build.' },
  { title: 'Built in 2–3 Weeks', desc: 'Our experienced team of carpenters complete most builds within 2–3 weeks from start to handover.' },
];
---

<Layout title={title} description={description} canonical={canonical}>

  <!-- HERO -->
  <section style="position:relative; height:65vh; min-height:440px; display:flex; align-items:flex-end; overflow:hidden; background:#1a2328;">
    <img
      src={heroImg}
      srcset={heroSrcset}
      sizes="100vw"
      alt={heroAlt}
      fetchpriority="high"
      decoding="async"
      style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center;"
    />
    <div style="position:absolute; inset:0; background:linear-gradient(to right, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.3) 40%, rgba(0,0,0,0) 70%);"></div>
    <div style="position:relative; z-index:1; max-width:1280px; margin:0 auto; padding:0 24px 56px; width:100%;">
      <p style="color:#34a02e; font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.1em; margin-bottom:12px;">{tagline}</p>
      <h1 style="font-family:'Poppins',sans-serif; font-size:clamp(2.2rem,5vw,3.5rem); font-weight:700; color:#fff; margin:0 0 16px; line-height:1.1;">{h1}</h1>
      <div style="display:flex; flex-wrap:wrap; align-items:center; gap:12px;">
        {price && <div style="display:inline-block; background:#34a02e; color:#fff; font-size:14px; font-weight:700; padding:8px 20px; border-radius:50px;">{price}</div>}
        <a href="/garden-room-price-calculator" style="display:inline-flex; align-items:center; gap:8px; background:rgba(255,255,255,0.15); backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,0.25); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:13px; padding:8px 20px; border-radius:50px; text-decoration:none; transition:all 0.2s;">
          Get an Instant Quote →
        </a>
      </div>
    </div>
  </section>

  <!-- BREADCRUMB -->
  <div style="background:#1a2328; padding:12px 24px;">
    <div style="max-width:1280px; margin:0 auto; display:flex; align-items:center; gap:8px; font-size:13px;">
      <a href="/" style="color:rgba(255,255,255,0.6); text-decoration:none; transition:color 0.2s;" class="bc-link">Home</a>
      <span style="color:rgba(255,255,255,0.3);">›</span>
      <a href="/garden-rooms/garden-offices" style="color:rgba(255,255,255,0.6); text-decoration:none;" class="bc-link">Garden Rooms</a>
      <span style="color:rgba(255,255,255,0.3);">›</span>
      <span style="color:#34a02e; font-weight:600;">{h1}</span>
    </div>
  </div>

  <!-- INTRO + FEATURE CARDS — dark navy -->
  <section style="background:#2d3841; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px; display:grid; grid-template-columns:1.1fr 1fr; gap:72px; align-items:start;">
      <div>
        <slot name="intro-extra" />
        <p style="font-size:1.15rem; color:rgba(255,255,255,0.85); line-height:1.9; margin-bottom:32px;">{intro}</p>
        <div style="display:flex; flex-wrap:wrap; gap:12px;">
          <a href="/garden-room-price-calculator" class="btn-primary" style="font-size:15px; padding:14px 32px;">Get an Instant Quote</a>
          <a href="/contact-us" style="display:inline-flex; align-items:center; gap:8px; border:2px solid rgba(255,255,255,0.3); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none; transition:all 0.2s;" class="btn-ghost">Book a Free Site Visit</a>
        </div>
      </div>
      <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
        {features.slice(0,4).map((f, i) => (
          <div style="background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.1); border-radius:16px; padding:22px; transition:background 0.2s;" class="feat-card">
            <div style="width:36px; height:36px; background:#34a02e; border-radius:10px; display:flex; align-items:center; justify-content:center; margin-bottom:14px;">
              <Icon name={f.icon} size={18} color="#fff" />
            </div>
            <p style="font-size:13px; font-weight:700; color:#fff; margin:0 0 5px;">{f.title}</p>
            <p style="font-size:12px; color:rgba(255,255,255,0.6); line-height:1.6; margin:0;">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED — fixed comprehensive list -->
  <section style="background:#e7f1e3; padding:72px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="text-align:center; margin-bottom:40px;">
        <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#2d3841; margin-bottom:8px;">What's Included in Every Build</h2>
        <p style="color:#555; font-size:1rem; margin:0;">Fully turnkey — we handle everything. You unlock the door on the last day and walk into a finished room.</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:12px; margin-bottom:20px;">
        {[
          { icon: 'tools',       label: 'Ground screw foundations',     note: 'No concrete, no excavation' },
          { icon: 'layers',      label: 'SIPs panels throughout',       note: 'Walls, floor and roof' },
          { icon: 'shield',      label: 'EPDM or metal roof',           note: '20-year guarantee as standard' },
          { icon: 'box',         label: 'External cladding',            note: 'Premium finish, 30+ year lifespan' },
          { icon: 'door',        label: 'Doors and windows',            note: 'Fitted and glazed' },
          { icon: 'lightning',   label: 'Full mains electrical',        note: 'Sockets, lighting, consumer unit' },
          { icon: 'certificate', label: 'Electrical certificate',       note: 'Signed and issued on handover' },
          { icon: 'bulb',        label: 'LED lighting',                 note: 'Internal and external as specified' },
          { icon: 'pencil',      label: 'Fully plastered interior',     note: 'Smooth skim finish throughout' },
          { icon: 'ruler',       label: 'Fitted flooring',              note: 'Laid and finished' },
          { icon: 'check',       label: 'Full site clean-up',           note: 'We leave your garden spotless' },
          { icon: 'award',       label: '10-year structural guarantee', note: 'From handover day one' },
        ].map(item => (
          <div style="display:flex; align-items:flex-start; gap:12px; background:#fff; border-radius:12px; padding:16px 18px; border:1px solid rgba(52,160,46,0.2);">
            <div style="width:32px; height:32px; background:#34a02e; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:1px;">
              <Icon name={item.icon} size={16} color="#fff" />
            </div>
            <div>
              <p style="font-size:13px; font-weight:700; color:#2d3841; margin:0 0 2px;">{item.label}</p>
              <p style="font-size:12px; color:#777; margin:0;">{item.note}</p>
            </div>
          </div>
        ))}
      </div>
      <p style="text-align:center; font-size:12.5px; color:#888; margin:0;">Interior decorating (painting / wallpaper after plastering) is not included but can be arranged through our trusted decorator — just ask.</p>
    </div>
  </section>

  <!-- EXTRA CONTENT SLOT -->
  <slot />

  <!-- WHY US — dark with green accents -->
  <section style="background:#1a2328; padding:80px 0;">
    <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
      <div style="display:grid; grid-template-columns:1fr 2fr; gap:72px; align-items:start;">
        <div style="position:sticky; top:100px;">
          <div style="display:inline-block; background:rgba(52,160,46,0.15); color:#34a02e; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; padding:5px 14px; border-radius:50px; margin-bottom:16px;">Why Us</div>
          <h2 style="font-size:clamp(1.5rem,3vw,2.2rem); font-weight:700; color:#fff; line-height:1.2; margin-bottom:16px;">What Makes Us Stand Out</h2>
          <p style="color:rgba(255,255,255,0.6); font-size:1rem; line-height:1.8; margin-bottom:28px;">Every Green Rooms build uses the same premium specification — regardless of price point.</p>
          <a href="/why-us" class="btn-primary">Full Comparison</a>
        </div>
        <div style="display:flex; flex-direction:column; gap:0;">
          {whyUs.map((w, i) => (
            <div style={`padding:24px 0; border-bottom:1px solid rgba(255,255,255,0.08); display:flex; gap:20px; align-items:flex-start; ${i === 0 ? 'border-top:1px solid rgba(255,255,255,0.08);' : ''}`}>
              <div style="width:8px; height:8px; background:#34a02e; border-radius:50%; flex-shrink:0; margin-top:8px;"></div>
              <div>
                <p style="font-size:15px; font-weight:700; color:#fff; margin:0 0 5px;">{w.title}</p>
                <p style="font-size:13.5px; color:rgba(255,255,255,0.6); line-height:1.7; margin:0;">{w.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- QUOTE CTA — green -->
  <section style="background:#34a02e; padding:72px 24px; text-align:center;">
    <div style="max-width:560px; margin:0 auto;">
      <h2 style="font-size:clamp(1.5rem,3vw,2rem); font-weight:700; color:#fff; margin-bottom:14px;">Ready to Get a Price?</h2>
      <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin-bottom:28px;">Use our instant calculator to design your {h1.toLowerCase()} and get a guide price in under 3 minutes. No email required to see your estimate.</p>
      <div style="display:flex; justify-content:center; flex-wrap:wrap; gap:12px;">
        <a href="/garden-room-price-calculator" class="btn-white" style="font-size:15px; padding:14px 32px;">Get an Instant Quote</a>
        <a href="/contact-us" style="display:inline-flex; align-items:center; border:2px solid rgba(255,255,255,0.5); color:#fff; font-family:'Poppins',sans-serif; font-weight:600; font-size:14px; padding:12px 28px; border-radius:50px; text-decoration:none; transition:all 0.2s;" class="btn-ghost-light">Book a Free Site Visit</a>
      </div>
    </div>
  </section>

  <!-- RELATED -->
  {relatedPages.length > 0 && (
    <section style="background:#fff; padding:72px 0;">
      <div style="max-width:1280px; margin:0 auto; padding:0 24px;">
        <h2 style="font-size:1.5rem; font-weight:700; color:#2d3841; margin-bottom:28px;">You Might Also Like</h2>
        <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
          {relatedPages.map(r => (
            <a href={r.href} style="display:block; text-decoration:none; border-radius:16px; overflow:hidden; position:relative; height:220px;" class="related-card">
              <img src={r.img} alt={r.label} style="width:100%; height:100%; object-fit:cover; transition:transform 0.4s;" loading="lazy" class="related-img" />
              <div style="position:absolute; inset:0; background:linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 50%);"></div>
              <div style="position:absolute; bottom:16px; left:16px;">
                <p style="color:#fff; font-weight:700; font-size:15px; margin:0;">{r.label}</p>
                <p style="color:#34a02e; font-size:12px; font-weight:600; margin:3px 0 0;">Explore →</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

</Layout>

<style>
  .bc-link:hover { color: #fff !important; }
  .feat-card:hover { background: rgba(255,255,255,0.1) !important; }
  .btn-ghost:hover { background: rgba(255,255,255,0.1) !important; border-color: rgba(255,255,255,0.5) !important; }
  .btn-ghost-light:hover { background: rgba(255,255,255,0.15) !important; }
  .related-card:hover .related-img { transform: scale(1.05); }

  @media (max-width: 900px) {
    div[style*="grid-template-columns:1.1fr 1fr"],
    div[style*="grid-template-columns:1fr 2fr"] { grid-template-columns: 1fr !important; gap: 40px !important; }
    div[style*="grid-template-columns:repeat(3,1fr)"] { grid-template-columns: 1fr 1fr !important; }
    div[style*="grid-template-columns:repeat(4,1fr)"] { grid-template-columns: 1fr 1fr !important; }
    div[style*="position:sticky"] { position: static !important; }
  }
  @media (max-width: 600px) {
    div[style*="grid-template-columns:repeat(3,1fr)"],
    div[style*="grid-template-columns:repeat(4,1fr)"],
    div[style*="grid-template-columns:1fr 1fr"] { grid-template-columns: 1fr !important; }
  }
</style>
