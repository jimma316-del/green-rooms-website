---
const services = [
  { label: 'Garden Pods', href: '/garden-rooms/garden-pods' },
  { label: 'Garden Offices', href: '/garden-rooms/garden-offices' },
  { label: 'Garden Rooms', href: '/garden-rooms/garden-rooms' },
  { label: 'Garden Rooms with Storage', href: '/garden-rooms/garden-rooms-with-storage' },
  { label: 'Golf Simulator Studios', href: '/garden-rooms/golf-simulator-studios' },
  { label: 'Bespoke', href: '/garden-rooms/bespoke' },
];
const info = [
  { label: 'About Us', href: '/about' },
  { label: 'Our Work', href: '/our-work' },
  { label: 'Our Prices', href: '/our-prices' },
  { label: 'Why Us', href: '/why-us' },
  { label: 'Testimonials', href: '/testimonials' },
  { label: 'Showroom', href: '/showrooms' },

  { label: 'Planning', href: '/planning' },
  { label: 'Guarantee', href: '/guarantee' },
  { label: 'FAQ', href: '/faq' },
  { label: 'News', href: '/news' },
  { label: 'Contact Us', href: '/contact-us' },
];
