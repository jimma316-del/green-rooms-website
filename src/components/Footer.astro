    <!-- Services col -->
    <div>
      <h4 style="font-size:13px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:16px;">Garden Rooms</h4>
      <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px;">
        {services.map(item => (
          <li><a href={item.href} style="color:rgba(255,255,255,0.75); text-decoration:none; font-size:14px; transition:color 0.2s;" class="footer-link">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Info col -->
    <div>
      <h4 style="font-size:13px; font-weight:700; color:#34a02e; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:16px;">Information</h4>
      <ul style="list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px;">
        {info.map(item => (
          <li><a href={item.href} style="color:rgba(255,255,255,0.75); text-decoration:none; font-size:14px; transition:color 0.2s;" class="footer-link">{item.label}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div style="border-top:1px solid rgba(255,255,255,0.1); max-width:1280px; margin:0 auto; padding:20px 24px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
