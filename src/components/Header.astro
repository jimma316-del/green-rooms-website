    <!-- Full-width Garden Rooms mega menu — direct child of nav so left:0/right:0 spans full viewport width -->
    <div id="gr-mega" style="display:none; position:absolute; left:0; right:0; top:100%; background:#1a2328; z-index:200; padding:20px 24px 24px; border-top:3px solid #34a02e;">
