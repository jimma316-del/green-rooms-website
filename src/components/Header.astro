              <a href={item.href} style="display:block; padding:8px 16px; font-size:14px; font-weight:500; color:#2d3841; text-decoration:none; border-radius:8px; transition:background 0.15s;" class="dropdown-item">{item.label}</a>
            ))}
          </div>
        </div>

        <!-- Information dropdown -->
        <div class="nav-dropdown" style="position:relative;">
          <button class="nav-btn" style="display:flex; align-items:center; gap:4px; background:none; border:none; cursor:pointer; font-family:'Nunito',sans-serif; font-size:14px; font-weight:600; color:#fff; padding:8px 12px; border-radius:8px; transition:all 0.2s;">
            Information
