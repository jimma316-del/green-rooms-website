---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  preloadImg?: string;
}

const {
  title,
  description = 'Bespoke garden rooms, garden offices, garden gyms and golf simulator rooms hand built across Surrey and the South East. Expert craftsmanship, SIPs construction, 10-year guarantee.',
  image = '/images/og-default.webp',
  canonical,
  preloadImg,
} = Astro.props;

const siteUrl = 'https://www.thegreenrooms.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${image}`} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Green Rooms" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${image}`} />

  <!-- Preload LCP image if specified -->
  {preloadImg && (() => {
    const filename = preloadImg.split('/').pop()!;
    const decoded = decodeURIComponent(filename);
    const dot = decoded.lastIndexOf('.');
    const base = decoded.substring(0, dot);
    const sm = '/images/sm/' + encodeURIComponent(base + '-sm.webp');
    const imgSrcset = `${sm} 900w, ${preloadImg} 1920w`;
    return <link rel="preload" as="image" href={preloadImg} imagesrcset={imgSrcset} imagesizes="100vw" fetchpriority="high" />;
  })()}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Fonts — preconnect first, then single combined request -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap" />

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GS62TB80X8" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GS62TB80X8');
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
