---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  preloadImg?: string;
  breadcrumbItems?: { name: string; url: string }[];
}

const {
  title,
  description = 'Bespoke garden rooms, garden offices, garden gyms and golf simulator rooms hand built across Surrey and the South East. Expert craftsmanship, SIPs construction, 10-year guarantee.',
  image = '/images/og-default.webp',
  canonical,
  preloadImg,
  breadcrumbItems,
} = Astro.props;

const isHome = canonical === '/';
const siteUrl = 'https://www.thegreenrooms.com';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["HomeAndConstructionBusiness", "LocalBusiness"],
  "name": "The Green Rooms",
  "description": "Bespoke garden rooms, offices, gyms and golf simulator studios hand-built across Surrey and the South East using SIPs construction. Founded in 2019, fully turnkey from ground screws to final handover. 150+ builds completed. 5-star rated.",
  "url": "https://www.thegreenrooms.com",
  "logo": "https://cdn.prod.website-files.com/65fa73870456aaad8a954b46/661cf61b0d2c970adddf26ad_the-green-rooms%20White.webp",
  "image": `${siteUrl}/images/Hero%20GR.webp`,
  "telephone": "+441932640242",
  "email": "info@thegreenrooms.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Lyne Lane",
    "addressLocality": "Lyne",
    "addressRegion": "Surrey",
    "postalCode": "KT16 0AN",
    "addressCountry": "GB"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 51.3871, "longitude": -0.5275 },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Surrey" },
    { "@type": "AdministrativeArea", "name": "Berkshire" },
    { "@type": "AdministrativeArea", "name": "West London" },
    { "@type": "AdministrativeArea", "name": "South East England" }
  ],
  "knowsAbout": [
    "SIPs construction",
    "structural insulated panels",
    "bespoke garden rooms",
    "garden offices",
    "garden gyms",
    "golf simulator studios",
    "Permitted Development rights",
    "ground screw foundations",
    "EPDM roofing",
    "garden room planning permission",
    "garden room insulation",
    "bespoke garden buildings Surrey"
  ],
  "priceRange": "£££",
  "foundingDate": "2019",
  "leiCode": "14041171",
  "vatID": "GB412772509",
  "numberOfEmployees": { "@type": "QuantitativeValue", "minValue": 8, "maxValue": 12 },
  "founder": {
    "@type": "Person",
    "name": "James",
    "jobTitle": "Owner & Principal Designer",
    "worksFor": { "@type": "Organization", "name": "The Green Rooms", "url": "https://www.thegreenrooms.com" },
    "knowsAbout": ["SIPs construction", "bespoke garden rooms", "carpentry", "garden room design", "Surrey garden rooms"]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "reviewCount": "39",
    "bestRating": "5",
    "worstRating": "1"
  },
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" }
  ],
  "sameAs": [
    "https://www.facebook.com/thegreenroomsltd",
    "https://www.instagram.com/thegreenroomsltd/",
    "https://www.linkedin.com/company/the-green-rooms-surrey/"
  ]
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "url": "https://www.thegreenrooms.com",
  "name": "The Green Rooms",
  "description": "Bespoke garden rooms, offices, gyms and golf simulator studios built across Surrey and the South East"
};

const breadcrumbSchema = breadcrumbItems && breadcrumbItems.length > 1 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.name,
    "item": `${siteUrl}${item.url}`
  }))
} : null;

const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${siteUrl}${image}`} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Green Rooms" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={`${siteUrl}${image}`} />

  <!-- Preload LCP image if specified -->
  {preloadImg && (() => {
    const filename = preloadImg.split('/').pop()!;
    const decoded = decodeURIComponent(filename);
    const dot = decoded.lastIndexOf('.');
    const base = decoded.substring(0, dot);
    const sm = '/images/sm/' + encodeURIComponent(base + '-sm.webp');
    const imgSrcset = `${sm} 900w, ${preloadImg} 1920w`;
    return <link rel="preload" as="image" href={preloadImg} imagesrcset={imgSrcset} imagesizes="100vw" fetchpriority="high" />;
  })()}

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="192x192" href="/favicon-192.png" />

  <!-- Fonts — async load to eliminate render-blocking -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap" /></noscript>

  <!-- Structured data — LocalBusiness and WebSite fire on every page -->
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-GS62TB80X8" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-GS62TB80X8');
  </script>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>
